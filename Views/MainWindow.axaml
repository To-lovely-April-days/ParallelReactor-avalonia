<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ParallelReactor.ViewModels"
        xmlns:ctl="using:ParallelReactor.Controls"
        xmlns:models="using:ParallelReactor.Models"
        xmlns:conv="using:ParallelReactor.Converters"
        mc:Ignorable="d"
        x:Class="ParallelReactor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        MaxWidth="1280" MaxHeight="800"
        SystemDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="霍桐多通道平行反应仪控制系统"
        Background="#0c0c0f"
        FontFamily="Inter, Noto Sans SC, sans-serif">

  <Window.Resources>
    <conv:InverseBoolConverter x:Key="InvBool" />
    <conv:EqualsConverter x:Key="Eq" />
    <conv:StateColorConverter x:Key="StColor" />
  </Window.Resources>

  <!-- 全屏背景 + 4 行网格（64 / 46 / 1fr / 58）-->
  <Panel>
    <Panel.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#131316" Offset="0" />
        <GradientStop Color="#0e0e11" Offset="0.45" />
        <GradientStop Color="#160d10" Offset="1" />
      </LinearGradientBrush>
    </Panel.Background>

    <Grid RowDefinitions="64,46,*,88">

      <!-- ============ 顶栏 ============ -->
      <Grid Grid.Row="0" Margin="22,0">
        <!-- 左：品牌（logo 用图片，放 Assets/logo.png 替换）-->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    HorizontalAlignment="Left">
          <Image Source="avares://ParallelReactor/Assets/logo.png" Height="32"
                 Stretch="Uniform" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="霍桐仪器" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource OnDark}" LetterSpacing="2" />
            <TextBlock Text="HUOTONG INSTRUMENT" FontSize="8.5" FontWeight="Medium"
                       Foreground="{DynamicResource Body}" LetterSpacing="1.8" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- 中：标题（绝对居中）-->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="多通道平行反应仪" FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnDark}" LetterSpacing="6"
                     HorizontalAlignment="Center" />
          <TextBlock Text="MULTI-CHANNEL PARALLEL REACTOR · 8CH" FontSize="9" FontWeight="Medium"
                     Foreground="{DynamicResource Body}" LetterSpacing="3.5" Margin="0,4,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 右：信息区 -->
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    HorizontalAlignment="Right">
          <!-- WiFi（SVG 矢量还原：三段弧 + 底部圆点，红色）-->
          <Canvas Width="18" Height="18" VerticalAlignment="Center">
            <Canvas.RenderTransform>
              <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
            </Canvas.RenderTransform>
            <Path Data="M1.42 9a16 16 0 0 1 21.16 0" Stroke="{DynamicResource AccentBright}"
                  StrokeThickness="2.2" StrokeLineCap="Round" />
            <Path Data="M5 12.55a11 11 0 0 1 14 0" Stroke="{DynamicResource AccentBright}"
                  StrokeThickness="2.2" StrokeLineCap="Round" />
            <Path Data="M8.53 16.11a6 6 0 0 1 6.95 0" Stroke="{DynamicResource AccentBright}"
                  StrokeThickness="2.2" StrokeLineCap="Round" />
            <Ellipse Canvas.Left="11" Canvas.Top="19" Width="2" Height="2"
                     Fill="{DynamicResource AccentBright}" />
          </Canvas>
          <Border Width="1" Height="24" Background="{DynamicResource GlassLine2}" />
          <!-- 服务热线 -->
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="服务热线" FontSize="9" Foreground="{DynamicResource Mute}"
                       LetterSpacing="3" HorizontalAlignment="Right" />
            <TextBlock Text="021-67230701" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource OnDark}" LetterSpacing="0.5"
                       HorizontalAlignment="Right" Margin="0,1,0,0" />
          </StackPanel>
          <Border Width="1" Height="24" Background="{DynamicResource GlassLine2}" />
          <!-- 时钟 -->
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ClockTime}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource OnDark}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding ClockDate}" FontSize="9.5" Foreground="{DynamicResource Body}"
                       HorizontalAlignment="Right" Margin="0,1,0,0" />
          </StackPanel>
          <Border Width="1" Height="24" Background="{DynamicResource GlassLine2}" />
          <!-- 通知铃（SVG 矢量 + 报警脉冲动效 + 点击下拉列表）-->
          <Panel VerticalAlignment="Center">
            <Button x:Name="BellToggle" Classes="bell"
                    Classes.hasalarm="{Binding HasAlarm}"
                    Click="OnBellClick" ToolTip.Tip="通知">
              <!-- 内层 Panel 撑满整个 34×34 按钮，角标才会落在按钮右上角而不是盖住铃铛 -->
              <Panel Width="34" Height="34">
                <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Canvas Width="1024" Height="1024">
                    <Path Classes="bellfill" Data="M512.64 0a42.666667 42.666667 0 0 1 42.56 39.466667l0.128 3.2-0.021333 49.92c173.226667 15.573333 307.584 176.576 307.584 370.773333v126.72c0 54.954667 18.176 107.733333 50.602666 147.733333l17.408 21.482667c37.738667 46.549333 8.277333 121.706667-53.610666 121.706667h-188.202667a180.074667 180.074667 0 0 1-345.109333 0H155.733333c-61.888 0-91.349333-75.178667-53.589333-121.706667l17.408-21.504c32.426667-39.978667 50.581333-92.757333 50.581333-147.712v-126.72c0-191.296 130.389333-350.357333 299.84-369.962667V42.666667a42.666667 42.666667 0 0 1 42.666667-42.666667z m83.413333 881.002667h-159.082666a94.656 94.656 0 0 0 159.104 0zM527.765333 176.704H512.64l-0.469333-0.021333h-6.890667c-134.741333 0-246.485333 123.605333-249.728 279.68l-0.085333 7.018666v126.698667c0 74.261333-24.704 146.048-69.610667 201.429333l-3.392 4.138667h668.074667l-3.328-4.117333c-43.2-53.269333-67.712-121.685333-69.546667-192.896l-0.106667-8.554667v-126.72c0-159.36-113.045333-286.656-249.813333-286.656z" />
                  </Canvas>
                </Viewbox>
                <!-- 未读角标：锚定按钮右上角，轻微外探 -->
                <Border Classes="nbadge" Classes.pulse="{Binding HasAlarm}"
                        IsVisible="{Binding HasNotif}"
                        MinWidth="16" Height="16" CornerRadius="8" Padding="3,0"
                        BorderBrush="#0e0e11" BorderThickness="1.5"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Color="#e0394c" Offset="0" />
                      <GradientStop Color="#A41626" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <TextBlock Text="{Binding NotifCountText}" FontSize="10" FontWeight="Bold"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>
            </Button>

            <!-- 下拉通知列表 -->
            <Popup x:Name="NotifPopup" PlacementTarget="{Binding #BellToggle}"
                   Placement="BottomEdgeAlignedRight" HorizontalOffset="0" VerticalOffset="10"
                   IsLightDismissEnabled="True">
              <Border Width="340" CornerRadius="13" BorderThickness="1"
                      BorderBrush="{DynamicResource GlassLine2}" ClipToBounds="True"
                      BoxShadow="0 16 40 0 #8C000000">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#FA1E1E23" Offset="0" />
                    <GradientStop Color="#FA16161A" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                  <!-- 头部 -->
                  <Grid ColumnDefinitions="*,Auto" Margin="14,12,14,10">
                    <TextBlock Grid.Column="0" Text="通知" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnDark}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding NotifSummary}" FontSize="10.5"
                               Foreground="{DynamicResource Mute}" VerticalAlignment="Center" />
                  </Grid>
                  <Border Height="1" Background="{DynamicResource GlassLine}" />
                  <!-- 列表 -->
                  <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Notifications}" Margin="0,4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Notification">
                          <Border Classes="nli" Padding="14,10">
                            <Grid ColumnDefinitions="22,*,Auto">
                              <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                      Background="{Binding IconBackground}" VerticalAlignment="Top">
                                <Viewbox Width="12" Height="12">
                                  <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Icon}" Stroke="{Binding IconForeground}"
                                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" />
                                  </Canvas>
                                </Viewbox>
                              </Border>
                              <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnDark}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" FontSize="10.5"
                                           Foreground="{DynamicResource Body}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Tag}" FontSize="10"
                                         Foreground="{DynamicResource Mute}" VerticalAlignment="Top" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Border Height="1" Background="{DynamicResource GlassLine}" />
                  <!-- 底部 -->
                  <Grid ColumnDefinitions="*,Auto" Margin="12,8">
                    <TextBlock Grid.Column="0" Text="{Binding NotifTotalText}" FontSize="11"
                               Foreground="{DynamicResource Mute}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="nlflink"
                            Command="{Binding SwitchTabCmdCommand}" CommandParameter="alarm"
                            Click="OnNotifLinkClick">
                      <TextBlock Text="查看历史 →" FontSize="11" Foreground="{DynamicResource Body}" />
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>
            </Popup>
          </Panel>
          <!-- 头像（用图片，放 Assets/user-avatar.png 替换）-->
          <Border Width="34" Height="34" CornerRadius="17"
                  BorderBrush="{DynamicResource GlassLine2}" BorderThickness="1" ClipToBounds="True">
            <Image Source="avares://ParallelReactor/Assets/user-avatar.png" Width="30" Height="30"
                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </Grid>

      <!-- ============ 工具栏 ============ -->
      <Border Grid.Row="1" Margin="22,0" Height="36" VerticalAlignment="Center"
              CornerRadius="11" Background="{DynamicResource GlassSoft}"
              BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="7,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="tbtn go" Command="{Binding RunAllCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Classes="tico" Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z" />
                    <Path Classes="tico-fill" Data="M10 8l6 4-6 4z" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="开始运行" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="tbtn" Command="{Binding StopAllCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Classes="tico" Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z" />
                    <Path Classes="tico-fill" Data="M9 9h6v6H9z" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="全部停止" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Width="1" Height="20" Background="{DynamicResource GlassLine2}" Margin="3,0" />
            <Button Classes="tbtn">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                  <Canvas Width="1024" Height="1024">
                    <Path Classes="tico-fill" Data="M163.2656 477.792h277.44v64h-277.44zM1022.9456 984.32a30.24 30.24 0 0 0-0.704-5.056l-99.232-284.8 22.944-63.04h7.04a32 32 0 0 0 0-64h-286.08a32 32 0 0 0 0 64h6.56l23.136 63.52-98.88 283.968a85.12 85.12 0 0 1-1.856 10.624c0 0.448 0.224 0.832 0.224 1.28a31.008 31.008 0 0 0 0.96 4.608 31.808 31.808 0 0 0 1.984 7.584c0.416 0.896 1.152 1.6 1.664 2.432a31.648 31.648 0 0 0 5.536 7.424c0.64 0.608 1.536 0.96 2.24 1.504a31.424 31.424 0 0 0 8.384 4.96c0.224 0.096 0.32 0.256 0.544 0.32a184.864 184.864 0 0 1 10.464 1.92h362.56c0.544 0 1.056 0.224 1.6 0.224a31.872 31.872 0 0 0 10.56-1.792c0.544-0.192 0.928-0.64 1.472-0.896 0.832-0.32 1.44-0.928 2.24-1.312a31.616 31.616 0 0 0 8.096-5.44c0.512-0.544 0.832-1.216 1.312-1.792a31.744 31.744 0 0 0 5.44-8.096 32.864 32.864 0 0 0 0.96-3.552 31.296 31.296 0 0 0 1.696-8.352c0-0.352 0.192-0.64 0.192-1.024a30.176 30.176 0 0 0-1.056-5.216z m-349.984-26.784l87.712-251.968a59748.224 59748.224 0 0 1 1.536-11.008 31427.936 31427.936 0 0 0-1.696-11.2l-18.944-51.968h136.288l-18.912 51.968a30.08 30.08 0 0 0-0.576 3.744 24.288 24.288 0 0 0-0.128 13.696 29.984 29.984 0 0 0 0.544 3.872l88.128 252.896zM163.2656 318.624h408.512v64H163.2656z M64.0016 125.792h136v41.92a26.464 26.464 0 0 0 26.464 26.496h427.072a26.464 26.464 0 0 0 26.464-26.496v-41.92h136v338.08h64V100.672a38.592 38.592 0 0 0-38.24-38.88H680.0016V28.672a26.464 26.464 0 0 0-26.464-26.464H226.4656a26.464 26.464 0 0 0-26.464 26.432v33.152H38.2416A38.592 38.592 0 0 0 0.0016 100.672v882.24a38.592 38.592 0 0 0 38.24 38.88H486.7216v-64H64.0016zM264.0016 66.24h352v64h-352z" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="配方模板" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="tbtn">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                  <Canvas Width="1024" Height="1024">
                    <Path Classes="tico-fill" Data="M491.008 386.048c0-97.792 176.64-244.224 176.64-244.224S844.8 288.256 844.8 386.048 765.44 563.2 668.16 563.2s-177.152-78.848-177.152-177.152z M562.688 383.488c0-57.856 104.96-144.896 104.96-144.896s105.472 87.04 105.472 144.896-47.104 104.96-104.96 104.96-105.472-46.592-105.472-104.96z M397.312 221.696h-289.28c-22.016 0-39.936-17.92-39.936-39.424 0-22.016 17.92-39.936 39.936-39.936h289.28c22.016 0 39.424 17.92 39.424 39.936 0 21.504-17.408 39.424-39.424 39.424zM927.232 894.976h-819.2c-22.016 0-39.936-17.92-39.936-39.936s17.92-39.424 39.936-39.424h819.2c22.016 0 39.424 17.92 39.424 39.424 0 22.016-17.408 39.936-39.424 39.936zM750.08 729.6h-464.896c-22.016 0-39.936-17.92-39.936-39.936s17.92-39.424 39.936-39.424h464.896c22.016 0 39.424 17.92 39.424 39.424 0 22.016-17.92 39.936-39.424 39.936zM297.472 384.512h-189.44c-22.016 0-39.936-17.92-39.936-39.424 0-22.016 17.92-39.936 39.936-39.936h189.44c22.016 0 39.424 17.92 39.424 39.936 0 21.504-17.408 39.424-39.424 39.424z M147.456 524.288V855.04c0 22.016-17.92 39.936-39.424 39.936-22.016 0-39.936-17.92-39.936-39.936v-330.24c0-22.016 17.92-39.936 39.936-39.936 22.016 0.512 39.424 18.432 39.424 39.424zM966.656 524.288V855.04c0 22.016-17.92 39.936-39.424 39.936-22.016 0-39.424-17.92-39.424-39.936v-330.24c0-22.016 17.92-39.936 39.424-39.936 22.016 0.512 39.424 18.432 39.424 39.424zM364.544 564.736h-79.36c-22.016 0-39.936-17.92-39.936-39.936s17.92-39.424 39.936-39.424h79.36c22.016 0 39.424 17.92 39.424 39.424 0.512 22.016-17.408 39.936-39.424 39.936z" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="泄漏测试" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Width="1" Height="20" Background="{DynamicResource GlassLine2}" Margin="3,0" />
            <Button Classes="tbtn man" Classes.on="{Binding ManualValve}"
                    Command="{Binding ToggleManualCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                  <Canvas Width="1024" Height="1024">
                    <Path Classes="tico-fill" Data="M251.112727 432.989091q17.710545 40.890182 49.966546 72.378182l32.535272-33.28Q279.272727 419.025455 279.272727 344.133818q0-74.914909 54.341818-127.953454Q388.165818 162.909091 465.454545 162.909091q77.265455 0 131.84 53.294545Q651.636364 269.195636 651.636364 344.110545q0 74.891636-54.341819 127.953455l32.535273 33.28q32.256-31.488 49.966546-72.378182 18.385455-42.426182 18.385454-88.855273t-18.385454-88.855272q-17.710545-40.890182-49.989819-72.378182-32.186182-31.464727-73.937454-48.709818Q512.674909 116.363636 465.454545 116.363636q-47.243636 0-90.414545 17.826909-41.751273 17.221818-73.960727 48.686546-32.256 31.511273-49.966546 72.401454-18.385455 42.426182-18.385454 88.855273t18.385454 88.855273zM394.077091 919.272727H751.941818l28.392727-301.521454-3.560727-8.238546q-13.847273-31.930182-58.647273-44.962909-33.838545-9.821091-89.6-9.821091-36.561455 0-58.321454-0.605091v-204.893091l-11.170909-10.356363Q507.275636 290.909091 473.530182 290.909091q-39.703273 0-93.370182 47.406545l-11.776 10.426182v257.466182q-30.673455-11.729455-52.689455-16.802909l-5.306181-1.233455-5.422546 0.465455q-43.776 3.607273-66.024727 32.674909-21.061818 27.508364-17.268364 72.192l0.907637 10.519273 171.52 215.249454z m294.283636-69.818182h-260.654545L290.909091 677.725091q0.279273-9.774545 3.490909-13.963636 2.699636-3.514182 11.264-4.933819 30.72 8.075636 83.362909 31.650909l49.198546 22.039273V380.602182q23.133091-18.781091 34.094545-19.805091l0.232727 0.069818q3.118545 1.186909 7.912728 4.189091 8.610909 5.399273 19.921454 15.034182v205.591273q0 31.744 36.328727 36.375272 7.284364 0.930909 20.410182 1.466182 24.040727 1.024 71.400727 1.024 45.824 0 70.097455 7.051636 6.004364 1.745455 9.937455 3.677091l-20.177455 214.178909z" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="手动阀控" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Body}">
              <Run Text="运行 " /><Run Text="{Binding RunCountText}" Foreground="{DynamicResource GreenBright}" FontWeight="Bold" /><Run Text=" 通道" />
            </TextBlock>
            <Border Width="1" Height="20" Background="{DynamicResource GlassLine2}" />
            <Button Classes="estop" Command="{Binding EstopCommand}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                  <Canvas Width="1024" Height="1024">
                    <Path Classes="tico-fill estop-ico" Data="M512 960A448 448 0 1 1 512 64a448 448 0 0 1 0 896zM256 448a64 64 0 1 0 0 128h512a64 64 0 0 0 0-128H256z" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="急停" VerticalAlignment="Center" LetterSpacing="1.6" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ 首页面板 ============ -->
      <Border Grid.Row="2" Margin="22,6" CornerRadius="18"
              Background="{DynamicResource Glass}"
              BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" ClipToBounds="True">
        <Panel>
        <!-- ===== 首页 ===== -->
        <Grid RowDefinitions="Auto,*"
              IsVisible="{Binding ActiveTab, Converter={StaticResource Eq}, ConverterParameter=home}">
          <!-- 面板头 -->
          <Grid Grid.Row="0" Margin="20,16,20,8" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0">
              <TextBlock Text="反应器与气路系统" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnDark}" />
              <TextBlock Text="Reactor &amp; Gas Network" FontSize="9.5"
                         Foreground="{DynamicResource Body}" LetterSpacing="1.5" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Border Width="14" Height="4" CornerRadius="2">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Color="#84cc16" Offset="0" />
                      <GradientStop Color="#a3e635" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <TextBlock Text="气体流通" FontSize="11" Foreground="{DynamicResource Body}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Border Width="14" Height="4" CornerRadius="2" Background="#38FFFFFF" />
                <TextBlock Text="共用总管" FontSize="11" Foreground="{DynamicResource Body}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="点击反应釜可控制 · 阀门需开启手动阀控"
                         FontSize="11" Foreground="{DynamicResource Mute}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 搅拌总控（全局共用一台搅拌器：8 釜同开同关、同一转速）-->
            <Border Grid.Column="2" CornerRadius="11" Background="{DynamicResource GlassSoft}"
                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Padding="11,6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                  <Canvas Width="1024" Height="1024">
                    <Path Fill="#d4a8ff"
                          Data="M544 421.44V448a32 32 0 1 1-64 0v-64a32 32 0 0 1 32-32 160 160 0 0 1 160 160 32 32 0 1 1-64 0 96.032 96.032 0 0 0-64-90.56z m-64 181.12V576a32 32 0 0 1 64 0v64a32 32 0 0 1-32 32 160 160 0 0 1-160-160 32 32 0 1 1 64 0c0 41.792 26.72 77.344 64 90.56zM512 800a288 288 0 1 1 0-576 288 288 0 0 1 0 576z m0-512a224 224 0 1 0 0 448 224 224 0 0 0 0-448z" />
                  </Canvas>
                </Viewbox>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="搅拌总控" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" />
                  <TextBlock Text="全部反应釜共用" FontSize="9" Foreground="{DynamicResource Mute}" Margin="0,1,0,0" />
                </StackPanel>
                <!-- 转速（点击调起数字键盘）-->
                <Button Command="{Binding EditStirRpmCommand}" Padding="10,4" CornerRadius="8"
                        Background="#40000000" BorderBrush="{DynamicResource GlassLine2}" BorderThickness="1"
                        VerticalAlignment="Center" Cursor="Hand">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}">
                    <Run Text="{Binding StirRpm}" /><Run Text=" rpm" FontSize="9" Foreground="{DynamicResource Body}" />
                  </TextBlock>
                </Button>
                <!-- 开关 -->
                <Button Command="{Binding ToggleStirCommand}" Padding="0" Background="Transparent"
                        BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
                  <Panel Width="46" Height="25">
                    <Border CornerRadius="999" Background="{DynamicResource GlassBright}"
                            BorderBrush="{DynamicResource GlassLine2}" BorderThickness="1"
                            IsVisible="{Binding StirOn, Converter={x:Static conv:InverseBoolConverter.Instance}}">
                      <Ellipse Width="19" Height="19" Fill="#d8dcf0" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Border>
                    <Border CornerRadius="999" IsVisible="{Binding StirOn}">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                          <GradientStop Color="#84cc16" Offset="0" />
                          <GradientStop Color="#a3e635" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Ellipse Width="19" Height="19" Fill="#fff" HorizontalAlignment="Right" Margin="0,0,2,0" />
                    </Border>
                  </Panel>
                </Button>
              </StackPanel>
            </Border>
          </Grid>

          <!-- 气路图 -->
          <ctl:SchematicControl Grid.Row="1" x:Name="Schematic" Margin="14,0,14,12" />
        </Grid>

        <!-- ===== 程序界面 ===== -->
        <ContentControl IsVisible="{Binding ActiveTab, Converter={StaticResource Eq}, ConverterParameter=program}">
          <ctl:ProgramView DataContext="{Binding Program}" />
        </ContentControl>
        </Panel>
      </Border>

      <!-- ============ 底栏 ============ -->
      <Grid Grid.Row="3" Margin="22,8,22,0" ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Classes="tbtn" Background="Transparent"
                Command="{Binding LogoutCommand}" Foreground="{DynamicResource Body}">
          <TextBlock Text="← 退出登录" FontSize="12" />
        </Button>

        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="999" Height="52"
                Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
                BorderThickness="1" Padding="3">
          <StackPanel Orientation="Horizontal" Spacing="3" x:Name="Pills" VerticalAlignment="Stretch">
            <Button Classes="pill active" Command="{Binding SwitchTabCmdCommand}" CommandParameter="home">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Path Classes="navico" Data="M3 12l9-9 9 9 M5 10v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V10" />
                <TextBlock Classes="en" Text="HOME" VerticalAlignment="Center" />
                <TextBlock Classes="sep" Text="·" VerticalAlignment="Center" />
                <TextBlock Classes="zh" Text="总览" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill" Command="{Binding SwitchTabCmdCommand}" CommandParameter="program">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Path Classes="navico" Data="M3 3h18v6H3z M3 15h18v6H3z M7 9v6 M17 9v6" />
                <TextBlock Classes="en" Text="PROGRAM" VerticalAlignment="Center" />
                <TextBlock Classes="sep" Text="·" VerticalAlignment="Center" />
                <TextBlock Classes="zh" Text="程序" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill" Command="{Binding SwitchTabCmdCommand}" CommandParameter="graph">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Path Classes="navico" Data="M3 3v18h18 M7 14l4-4 4 3 5-6" />
                <TextBlock Classes="en" Text="GRAPH" VerticalAlignment="Center" />
                <TextBlock Classes="sep" Text="·" VerticalAlignment="Center" />
                <TextBlock Classes="zh" Text="曲线" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill" Command="{Binding SwitchTabCmdCommand}" CommandParameter="data">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Path Classes="navico" Data="M4 5c0 1.66 3.58 3 8 3s8-1.34 8-3-3.58-3-8-3-8 1.34-8 3z M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5 M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
                <TextBlock Classes="en" Text="DATA" VerticalAlignment="Center" />
                <TextBlock Classes="sep" Text="·" VerticalAlignment="Center" />
                <TextBlock Classes="zh" Text="记录" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill" Command="{Binding SwitchTabCmdCommand}" CommandParameter="alarm">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Path Classes="navico" Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M12 8v4 M12 16h0.01" />
                <TextBlock Classes="en" Text="ALARM" VerticalAlignment="Center" />
                <TextBlock Classes="sep" Text="·" VerticalAlignment="Center" />
                <TextBlock Classes="zh" Text="报警" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill" Command="{Binding SwitchTabCmdCommand}" CommandParameter="setting">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Path Classes="navico" Data="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                <TextBlock Classes="en" Text="SETTING" VerticalAlignment="Center" />
                <TextBlock Classes="sep" Text="·" VerticalAlignment="Center" />
                <TextBlock Classes="zh" Text="设置" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
          <TextBlock Text="MODEL" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource Mute}"
                     LetterSpacing="2" HorizontalAlignment="Right" />
          <TextBlock Text="HT-PR8" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource OnDark}"
                     LetterSpacing="1" HorizontalAlignment="Right" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- ============ 抽屉遮罩 ============ -->
    <Border x:Name="Backdrop" Background="#80060609"
            Opacity="{Binding Drawer.IsOpen, Converter={x:Static conv:BoolToOpacityConverter.Instance}}"
            IsHitTestVisible="{Binding Drawer.IsOpen}"
            PointerPressed="OnBackdropPressed">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Border.Transitions>
    </Border>

    <!-- ============ 抽屉（从右侧滑入动画）============ -->
    <ctl:DrawerView x:Name="Drawer" DataContext="{Binding Drawer}"
                    HorizontalAlignment="Right" Width="392"
                    RenderTransform="{Binding IsOpen, Converter={x:Static conv:BoolToTranslateConverter.Instance}}">
      <ctl:DrawerView.Transitions>
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.28" Easing="CubicEaseOut" />
        </Transitions>
      </ctl:DrawerView.Transitions>
    </ctl:DrawerView>
    <!-- ============ Toast 容器 ============ -->
    <StackPanel x:Name="ToastHost" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,80" Spacing="8" />

    <!-- ============ 程序界面弹窗（DataContext = Program）============ -->
    <Panel x:CompileBindings="False" DataContext="{Binding Program}">

      <!-- 16 段升温曲线编辑器 -->
      <Panel IsVisible="{Binding IsCurveEditorOpen}">
        <Border Background="#99060609" />
        <Border Classes="pmodal" Width="840" HorizontalAlignment="Center" VerticalAlignment="Center">
          <DockPanel>
            <!-- 头 -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="22,18,22,12">
              <Border Width="36" Height="36" CornerRadius="11" Background="#2Ef0a830" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M3 17l5-5 4 4 8-9 M14 7h7v7" Stroke="{DynamicResource Amber}"
                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                  </Canvas>
                </Viewbox>
              </Border>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="16 段升温曲线" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OnDark}" />
                <TextBlock Text="{Binding CurveSub}" FontSize="11" Foreground="{DynamicResource Body}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
            <!-- 底 -->
            <DockPanel DockPanel.Dock="Bottom" Margin="22,4,22,20">
              <StackPanel Orientation="Horizontal" Spacing="7" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Button Classes="scopebtn" Classes.on="{Binding CurveScopeIsAll}" Command="{Binding CurveScopeAllCommand}" Content="应用：全部通道" />
                <Button Classes="scopebtn" Classes.on="{Binding CurveScopeIsCur}" Command="{Binding CurveScopeCurCommand}" Content="仅当前通道" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="mfbtn" Command="{Binding CancelCurveCommand}" Content="取消" />
                <Button Classes="mfbtn danger" Command="{Binding ApplyCurveCommand}" Content="应用曲线" />
              </StackPanel>
            </DockPanel>
            <!-- 主体 -->
            <StackPanel Margin="22,0">
              <Border Classes="curvebig">
                <Panel>
                  <Viewbox Stretch="Fill">
                    <Canvas Width="800" Height="240">
                      <Path Data="{Binding CurveGridGeo}" Stroke="#10FFFFFF" StrokeThickness="1" />
                      <Path Data="{Binding CurveAreaGeo}" Fill="#2Bf0a830" />
                      <Path Data="{Binding CurveLineGeo}" Stroke="#f0a830" StrokeThickness="2"
                            StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="{Binding CurveTotalLabel}" Classes="ctlabel"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10" />
                </Panel>
              </Border>
              <!-- 段表头 -->
              <Grid ColumnDefinitions="36,*,*,*,32" Margin="0,14,0,6">
                <TextBlock Grid.Column="0" Text="段" Classes="seghd" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="目标温度 (°C)" Classes="seghd" Margin="0,0,7,0" />
                <TextBlock Grid.Column="2" Text="升温斜率 (°C/min)" Classes="seghd" Margin="0,0,7,0" />
                <TextBlock Grid.Column="3" Text="保温时长 (min)" Classes="seghd" Margin="0,0,7,0" />
              </Grid>
              <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CurveSegs}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="7" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:HeatSeg">
                      <Grid ColumnDefinitions="36,*,*,*,32">
                        <TextBlock Grid.Column="0" Text="{Binding No}" Classes="segno"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="sinpbtn" Content="{Binding Temp}" Margin="0,0,7,0"
                                Command="{Binding $parent[ItemsControl].DataContext.EditSegTempCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Classes="sinpbtn" Content="{Binding Rate}" Margin="0,0,7,0"
                                Command="{Binding $parent[ItemsControl].DataContext.EditSegRateCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="3" Classes="sinpbtn" Content="{Binding Hold}" Margin="0,0,7,0"
                                Command="{Binding $parent[ItemsControl].DataContext.EditSegHoldCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="4" Classes="segdel"
                                Command="{Binding $parent[ItemsControl].DataContext.DelSegCommand}"
                                CommandParameter="{Binding}">
                          <Viewbox Width="11" Height="11"><Canvas Width="24" Height="24"><Path Data="M18 6L6 18 M6 6l12 12" Stroke="{DynamicResource Mute}" StrokeThickness="2.2" StrokeLineCap="Round" /></Canvas></Viewbox>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button Classes="segadd" Command="{Binding AddSegCommand}" IsEnabled="{Binding CanAddSeg}" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M12 5v14 M5 12h14" Stroke="{DynamicResource Body}" StrokeThickness="2" StrokeLineCap="Round" /></Canvas></Viewbox>
                  <TextBlock Text="添加段（最多 16）" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>
      </Panel>

      <!-- 应用到其他通道 -->
      <Panel IsVisible="{Binding IsApplyOpen}">
        <Border Background="#99060609" />
        <Border Classes="pmodal" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <!-- 头 -->
            <Grid ColumnDefinitions="Auto,*" Margin="22,18,22,12">
              <Border Width="36" Height="36" CornerRadius="11" Background="#2Ea86ce0" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                  <Canvas Width="24" Height="24">
                    <Path Data="M9 9h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2z M5 15V5a2 2 0 0 1 2-2h10"
                          Stroke="#d4a8ff" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                  </Canvas>
                </Viewbox>
              </Border>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ApplyTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OnDark}" />
                <TextBlock Text="{Binding ApplySub}" FontSize="11" Foreground="{DynamicResource Body}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
            <!-- 主体 -->
            <StackPanel Margin="22,0,22,4">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
                <Button Classes="qbtn" Command="{Binding ApplyQuickActiveCommand}" Content="所有运行中" />
                <Button Classes="qbtn" Command="{Binding ApplyQuickAllCommand}" Content="全部" />
                <Button Classes="qbtn" Command="{Binding ApplyQuickNoneCommand}" Content="清空" />
              </StackPanel>
              <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ApplyRows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApplyRow">
                      <Button Classes="applyrow" Classes.cur="{Binding IsCurrent}"
                              Classes.dis="{Binding Channel.Reactor.IsIdle}"
                              Command="{Binding ToggleCommand}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsPicked}" IsHitTestVisible="False"
                                    IsVisible="{Binding CanPick}" VerticalAlignment="Center" Margin="0,0,4,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                     Width="46" VerticalAlignment="Center" Foreground="{DynamicResource OnDark}" />
                          <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="11"
                                     Foreground="{DynamicResource Mute}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding StepsText}" FontSize="10.5"
                                     Foreground="{DynamicResource Body}" VerticalAlignment="Center" />
                          <Border Grid.Column="4" Classes="srctag" IsVisible="{Binding IsCurrent}" Margin="8,0,0,0">
                            <TextBlock Text="源" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Border Classes="applynote" Margin="0,12,0,0">
                <TextBlock FontSize="11.5" Foreground="#b6d4f5" TextWrapping="Wrap" LineHeight="17"
                           Text="注意：勾选的通道将被完整覆盖当前程序。被覆盖的程序如未保存模板将丢失。" />
              </Border>
            </StackPanel>
            <!-- 底 -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="22,16,22,20">
              <Button Classes="mfbtn" Command="{Binding CancelApplyCommand}" Content="取消" />
              <Button Classes="mfbtn pri" Command="{Binding ApplyDoCommand}" Content="应用" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Panel>

    <!-- ============ 预运行检查 ============ -->
    <Panel IsVisible="{Binding IsPreRunOpen}">
      <Border Background="#99060609" />
      <Border Classes="pmodal" Width="560" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <!-- 头 -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="22,18,22,12">
            <Border Width="36" Height="36" CornerRadius="11" Background="#2E84cc16" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                  <Path Data="M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
                        Stroke="#a3e635" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                </Canvas>
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="预运行检查" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource OnDark}" />
              <TextBlock Text="{Binding PreRunSummary}" FontSize="11" Foreground="{DynamicResource Body}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
          <!-- 底 -->
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                      HorizontalAlignment="Right" Margin="22,6,22,20">
            <Button Classes="mfbtn" Command="{Binding CancelPreRunCommand}" Content="取消" />
            <Button Classes="mfbtn go" Command="{Binding ConfirmRunCommand}"
                    IsEnabled="{Binding PreRunCanRun}" Content="确认开始运行" />
          </StackPanel>
          <!-- 检查项列表 -->
          <ScrollViewer MaxHeight="440" Margin="22,0,22,4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PreRunChecks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PreRunCheck">
                  <Border CornerRadius="11" Background="{Binding TintBg}" BorderBrush="{Binding Tint}"
                          BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Width="26" Height="26" CornerRadius="13" Background="{Binding TintBg}" VerticalAlignment="Top">
                        <Viewbox Width="14" Height="14">
                          <Canvas Width="24" Height="24">
                            <Path Data="{Binding Icon}" Stroke="{Binding Tint}" StrokeThickness="2.2"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                          </Canvas>
                        </Viewbox>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnDark}" />
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource Body}"
                                   Margin="0,2,0,0" TextWrapping="Wrap" LineHeight="15" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>

    <!-- ============ 屏幕全键盘（中央模态，置于最顶层，确保在所有弹窗之上）============ -->
    <Border Background="#A6000000" IsVisible="{Binding Keyboard.IsOpen}">
      <ctl:OnScreenKeyboard DataContext="{Binding Keyboard}" />
    </Border>
  </Panel>
</Window>
