<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:ParallelReactor.Views"
        x:Class="ParallelReactor.Views.MainWindow"
        SystemDecorations="None"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Title="霍桐多通道平行反应仪控制系统"
        Background="#0c0c0f"
        Width="1280" Height="720">
	<!-- X11/桌面外壳：铺满屏幕在 code-behind 完成，内容托管 MainView（与 DRM 单视图共用同一 MainView）。 -->
	<v:MainView />
</Window>
