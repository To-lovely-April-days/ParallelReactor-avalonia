    <Compile Include="../../Models/ProgramRunGuard.cs" Link="Src/ProgramRunGuard.cs" />
    <Compile Include="../../Models/GasLease.cs" Link="Src/GasLease.cs" />
    <!-- 第 4 组：命令层纯逻辑 -->
    <Compile Include="../../Commands/OpResult.cs" Link="Src/OpResult.cs" />
