    <Compile Include="../../Models/SettingSpecs.cs" Link="Src/SettingSpecs.cs" />
    <!-- P2 只读接口：Api/ 下的纯逻辑文件（不含 Api/Hmi/，那两个文件引用 Avalonia 与 ViewModels）+ 事件存储 -->
    <Compile Include="../../Service/EventStore.cs" Link="Src/EventStore.cs" />
    <Compile Include="../../Api/*.cs" Link="Src/Api/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 进程内集成测试要启动 Kestrel：与主工程一样只用共享框架引用，不加 NuGet 包 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
