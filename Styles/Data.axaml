<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- 表头列标题 -->
	<Style Selector="TextBlock.rth">
		<Setter Property="FontSize" Value="10" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="Foreground" Value="{DynamicResource Mute}" />
		<Setter Property="LetterSpacing" Value="0.5" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!-- 记录列表（容器样式见 DataView 的 ItemContainerTheme） -->
	<Style Selector="ListBox.runlist">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<!-- 关键指标卡片 -->
	<Style Selector="Border.rkv">
		<Setter Property="Background" Value="{DynamicResource Glass}" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="11,9" />
	</Style>
	<Style Selector="TextBlock.rkvk">
		<Setter Property="FontSize" Value="10.5" />
		<Setter Property="Foreground" Value="{DynamicResource Mute}" />
	</Style>
	<Style Selector="TextBlock.rkvv">
		<Setter Property="FontSize" Value="13.5" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource OnDark}" />
		<Setter Property="Margin" Value="0,3,0,0" />
	</Style>

	<!-- 详情操作按钮 -->
	<Style Selector="Button.rbtn">
		<Setter Property="Height" Value="40" />
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="CornerRadius" Value="9" />
		<Setter Property="Background" Value="{DynamicResource Glass}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource GlassLine2}" />
		<Setter Property="Foreground" Value="{DynamicResource OnDark}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Margin" Value="0,0,0,10" />
	</Style>
	<Style Selector="Button.rbtn /template/ ContentPresenter">
		<Setter Property="CornerRadius" Value="9" />
	</Style>
	<Style Selector="Button.rbtn:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource GlassBright}" />
	</Style>

</Styles>
