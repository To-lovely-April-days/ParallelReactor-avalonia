<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ParallelReactor.ViewModels"
             x:Class="ParallelReactor.Controls.DataView"
             x:CompileBindings="False"
             x:DataType="vm:DataViewModel">

  <!-- 样式内联在控件内，确保即使 App.axaml 未引入 Data.axaml 也能生效 -->
  <UserControl.Styles>
    <Style Selector="TextBlock.rth">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Mute}" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBox.runlist">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 分节标题（避免依赖 Graph.axaml 的 gsect） -->
    <Style Selector="TextBlock.rsect">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Mute}" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>

    <!-- 关键指标卡片 -->
    <Style Selector="Border.rkv">
      <Setter Property="Background" Value="{DynamicResource Glass}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,9" />
    </Style>
    <Style Selector="TextBlock.rkvk">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource Mute}" />
    </Style>
    <Style Selector="TextBlock.rkvv">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource OnDark}" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- 详情操作按钮 -->
    <Style Selector="Button.rbtn">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Glass}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassLine2}" />
      <Setter Property="Foreground" Value="{DynamicResource OnDark}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Button.rbtn /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.rbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GlassBright}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- 标题 -->
    <Grid Grid.Row="0" Margin="20,14,20,6" ColumnDefinitions="Auto,*">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Bottom">
        <TextBlock Text="运行记录" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" />
        <TextBlock Text="RUN HISTORY · 自动归档 · 点击查看详情" FontSize="9" FontWeight="Medium" VerticalAlignment="Bottom"
                   Foreground="{DynamicResource Body}" LetterSpacing="2" Margin="0,0,0,1" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="所有 .ear 文件自动归档 · 可导出至 Excel / 数据库" FontSize="11" HorizontalAlignment="Right"
                 Foreground="{DynamicResource Mute}" VerticalAlignment="Bottom" />
    </Grid>

    <!-- 主体：左表 + 右详情 -->
    <Grid Grid.Row="1" Margin="18,4,18,14" ColumnDefinitions="*,372">

      <!-- 左：记录表 -->
      <Border Grid.Column="0" Classes="graphcol" Margin="0,0,12,0" ClipToBounds="True">
        <DockPanel>
          <!-- 表头 -->
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource GlassLine}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="26,1.6*,1.1*,76,64,68,90">
              <TextBlock Grid.Column="1" Text="运行" Classes="rth" />
              <TextBlock Grid.Column="2" Text="开始时间" Classes="rth" />
              <TextBlock Grid.Column="3" Text="时长" Classes="rth" />
              <TextBlock Grid.Column="4" Text="通道" Classes="rth" />
              <TextBlock Grid.Column="5" Text="RSD %" Classes="rth" />
              <TextBlock Grid.Column="6" Text="状态" Classes="rth" />
            </Grid>
          </Border>
          <!-- 列表 -->
          <ListBox Classes="runlist" ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected, Mode=TwoWay}">
            <!-- 直接替换整个容器模板，彻底绕开 Fluent 默认蓝色选中态 -->
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                  <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                      <ContentPresenter Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                    </Border>
                  </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover">
                  <Setter Property="Background" Value="#7E26262C" />
                </Style>
                <!-- 选中：主题红（半透明，保证内容仍清晰可读） -->
                <Style Selector="^:selected">
                  <Setter Property="Background" Value="#40E0394C" />
                </Style>
                <Style Selector="^:selected:pointerover">
                  <Setter Property="Background" Value="#52E0394C" />
                </Style>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource GlassLine}" BorderThickness="0,0,0,1">
                  <Panel>
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource AccentBright}"
                               IsVisible="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    <Grid Margin="16,12" ColumnDefinitions="26,1.6*,1.1*,76,64,68,90">
                      <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Fill="{Binding StatusBrush}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" />
                        <TextBlock Text="{Binding Recipe}" FontSize="10" Foreground="{DynamicResource Mute}" Margin="0,2,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Start}" FontSize="11" Foreground="{DynamicResource Body}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Dur}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Rvs}" FontSize="12" Foreground="{DynamicResource Body}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding Rsd}" FontSize="12" Foreground="{Binding RsdBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                 Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </Panel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 右：详情 -->
      <Border Grid.Column="1" Classes="graphcol" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}">
          <StackPanel>
            <TextBlock Text="{Binding Selected.Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" />
            <TextBlock Text="{Binding Selected.FileMeta}" FontSize="11" Foreground="{DynamicResource Body}" Margin="0,3,0,0" />

            <!-- 备注 / 异常标注：中性卡片，颜色只用于图标与标签 -->
            <Border IsVisible="{Binding Selected.HasNote}" Margin="0,11,0,0" CornerRadius="8" Padding="11,9"
                    Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{Binding Selected.NoteIcon}" Stroke="{Binding Selected.NoteBar}" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Selected.NoteTag}" FontSize="10.5" FontWeight="Bold" LetterSpacing="0.5"
                           Foreground="{Binding Selected.NoteBar}" VerticalAlignment="Center" />
                <Rectangle Width="1" Height="11" Fill="{DynamicResource GlassLine2}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Selected.Note}" FontSize="12" Foreground="#cdced6"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- 汇总曲线 -->
            <TextBlock Text="气体消耗曲线（汇总）" Classes="rsect" Margin="0,18,0,9" />
            <Border Height="96" CornerRadius="8" Background="{DynamicResource Glass}" Padding="6" ClipToBounds="True">
              <Viewbox Stretch="Fill">
                <Canvas Width="320" Height="72">
                  <Polygon Points="{Binding SparkArea}" Fill="{Binding SparkColor}" Opacity="0.13" />
                  <Polyline Points="{Binding SparkLine}" Stroke="{Binding SparkColor}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                </Canvas>
              </Viewbox>
            </Border>

            <!-- 关键指标 -->
            <TextBlock Text="关键指标" Classes="rsect" Margin="0,18,0,9" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
              <Border Grid.Row="0" Grid.Column="0" Classes="rkv" Margin="0,0,5,9">
                <StackPanel>
                  <TextBlock Text="平均气体消耗" Classes="rkvk" />
                  <TextBlock Classes="rkvv"><Run Text="{Binding Selected.MmolText}" /><Run Text=" mmol" FontSize="10" Foreground="{DynamicResource Mute}" /></TextBlock>
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="1" Classes="rkv" Margin="5,0,0,9">
                <StackPanel>
                  <TextBlock Text="通道间 rsd" Classes="rkvk" />
                  <TextBlock Text="{Binding Selected.Rsd}" Classes="rkvv" Foreground="{Binding Selected.RsdBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Classes="rkv" Margin="0,0,5,0">
                <StackPanel>
                  <TextBlock Text="反应温度" Classes="rkvk" />
                  <TextBlock Classes="rkvv"><Run Text="{Binding Selected.TText}" /><Run Text=" °C" FontSize="10" Foreground="{DynamicResource Mute}" /></TextBlock>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Classes="rkv" Margin="5,0,0,0">
                <StackPanel>
                  <TextBlock Text="反应压力" Classes="rkvk" />
                  <TextBlock Classes="rkvv"><Run Text="{Binding Selected.PText}" /><Run Text=" psi" FontSize="10" Foreground="{DynamicResource Mute}" /></TextBlock>
                </StackPanel>
              </Border>
            </Grid>

            <!-- 操作 -->
            <TextBlock Text="操作" Classes="rsect" Margin="0,18,0,9" />
            <Button Classes="rbtn" Command="{Binding ViewCurveCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M3 3v18h18 M7 14l4-4 4 3 5-6" Stroke="{DynamicResource Body}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                <TextBlock Text="查看完整曲线" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="rbtn" Command="{Binding ExportEarCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3" Stroke="{DynamicResource Body}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                <TextBlock Text="导出 .ear 文件" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="rbtn" Command="{Binding ToTemplateCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8" Stroke="{DynamicResource Body}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                <TextBlock Text="转为程序模板" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="rbtn" Command="{Binding CopyParamsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M9 9h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2z M5 15V5a2 2 0 0 1 2-2h10" Stroke="{DynamicResource Body}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                <TextBlock Text="复制参数到当前运行" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
