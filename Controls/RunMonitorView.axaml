<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ParallelReactor.ViewModels"
             xmlns:ctl="using:ParallelReactor.Controls"
             x:Class="ParallelReactor.Controls.RunMonitorView"
             x:CompileBindings="False"
             x:DataType="vm:ProgramViewModel">

  <Grid Background="{DynamicResource PanelBg2}" RowDefinitions="Auto,*,Auto">
    <!-- 监控页头：当前通道、运行阶段和实时读数 -->
    <Border Grid.Row="0" Margin="18,14,18,0" CornerRadius="15"
            Background="{DynamicResource Glass}" BorderBrush="#2AC11B2E"
            BorderThickness="1" Padding="22,15">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="运行监控" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource OnDark}" />
            <Border Background="#16C11B2E" BorderBrush="#55C11B2E" BorderThickness="1"
                    CornerRadius="8" Padding="9,4" VerticalAlignment="Center">
              <TextBlock Text="实时执行" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBright}" />
            </Border>
          </StackPanel>
          <TextBlock Text="PROGRAM MONITOR · 左侧看流程，右侧看趋势" FontSize="12"
                     Foreground="{DynamicResource Mute}" LetterSpacing="1.4" Margin="0,4,0,0" />
          <!-- 多程序并行：监视显示选中通道的运行；其他通道有程序在跑时一行紧凑提示 -->
          <TextBlock Text="{Binding RunningSummary}" IsVisible="{Binding HasOtherRuns}" FontSize="12"
                     Foreground="{DynamicResource AccentBright}" Margin="0,3,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="34,0,20,0">
          <TextBlock Text="{Binding RunMonitorPhase}" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnDark}" />
          <TextBlock Text="{Binding RunMonitorDetail}" FontSize="13" Foreground="{DynamicResource Body}"
                     TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
          <StackPanel Margin="0,0,18,0">
            <TextBlock Text="温度" FontSize="12.5" Foreground="{DynamicResource Mute}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding MonitorReactor.TText, StringFormat='{}{0} °C'}"
                       FontSize="19" FontWeight="Bold" Foreground="{DynamicResource OnDark}" HorizontalAlignment="Right" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,18,0">
            <TextBlock Text="压力" FontSize="12.5" Foreground="{DynamicResource Mute}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding MonitorReactor.PText}" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource OnDark}" HorizontalAlignment="Right" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="进度" FontSize="12.5" Foreground="{DynamicResource Mute}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding RunProgressText}" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBright}" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18,14" ColumnDefinitions="360,*">
      <!-- 左侧：流程步骤状态 -->
      <Border Grid.Column="0" Classes="runmonitorcol" Padding="14" Margin="0,0,14,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,11">
            <StackPanel>
              <TextBlock Text="流程执行状态" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" />
              <TextBlock Text="STEP STATUS" FontSize="11.5" Foreground="{DynamicResource Mute}" LetterSpacing="1.5" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding RunProgressText}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBright}" VerticalAlignment="Center" />
          </Grid>
          <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource GlassLine}" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding RunSteps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProgramRunStep">
                  <Border Classes="runstep" Classes.current="{Binding IsCurrent}"
                          Classes.completed="{Binding IsCompleted}" Classes.failed="{Binding IsFailed}"
                          Classes.aborted="{Binding IsAborted}" Padding="11,10">
                    <Grid ColumnDefinitions="34,*,Auto">
                      <Border Width="32" Height="32" CornerRadius="16" Background="{Binding StateBackground}"
                              VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusGlyph}" FontSize="18" FontWeight="Bold"
                                   Foreground="{Binding StateBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding IndexText}" FontSize="13" FontWeight="Bold"
                                     Foreground="{DynamicResource Mute}" />
                          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                     Foreground="{DynamicResource OnDark}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{DynamicResource Body}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{Binding StateBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{Binding StateBrush}" VerticalAlignment="Top" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Grid.Row="2" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
                  BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,11,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="8" Height="8" Fill="#4d9a12" VerticalAlignment="Center" />
                <TextBlock Text="已完成" FontSize="12" Foreground="{DynamicResource Body}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBright}" VerticalAlignment="Center" />
                <TextBlock Text="执行中" FontSize="12" Foreground="{DynamicResource Body}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="8" Height="8" Fill="#d5394d" VerticalAlignment="Center" />
                <TextBlock Text="失败" FontSize="12" Foreground="{DynamicResource Body}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- 右侧：实时曲线监控 -->
      <Border Grid.Column="1" Classes="runmonitorcol" Padding="14">
        <Grid DataContext="{Binding MonitorGraph}" RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,10">
            <StackPanel>
              <TextBlock Text="曲线监控" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" />
              <TextBlock Text="LIVE TREND" FontSize="11.5" Foreground="{DynamicResource Mute}" LetterSpacing="1.5" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="runmetric" Classes.on="{Binding MetricIsT}" Command="{Binding SetMetricCommand}" CommandParameter="T" Content="温度" />
              <Button Classes="runmetric" Classes.on="{Binding MetricIsP}" Command="{Binding SetMetricCommand}" CommandParameter="P" Content="压力" />
              <Button Classes="runmetric" Classes.on="{Binding MetricIsGas}" Command="{Binding SetMetricCommand}" CommandParameter="gas" Content="气体" />
              <Button Classes="runmetric" Classes.on="{Binding MetricIsAll}" Command="{Binding SetMetricCommand}" CommandParameter="all" Content="全部" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource GlassLine}" />

          <Border Grid.Row="1" Classes="runchart" Margin="0,10,0,0">
            <ctl:GraphControl x:Name="MonitorChart" />
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="2,10,2,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="runrange" Classes.on="{Binding RangeIs5}" Command="{Binding SetRangeCommand}" CommandParameter="5" Content="5 分钟" />
              <Button Classes="runrange" Classes.on="{Binding RangeIs15}" Command="{Binding SetRangeCommand}" CommandParameter="15" Content="15 分钟" />
              <Button Classes="runrange" Classes.on="{Binding RangeIs60}" Command="{Binding SetRangeCommand}" CommandParameter="60" Content="1 小时" />
              <Button Classes="runrange" Classes.on="{Binding RangeIsAll}" Command="{Binding SetRangeCommand}" CommandParameter="all" Content="全程" />
            </StackPanel>
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Legend}" HorizontalAlignment="Right">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="12,0,0,0">
                    <Border Width="12" Height="3" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Body}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Margin="18,0,18,14" CornerRadius="14"
            Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassLine}"
            BorderThickness="1" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding RunMonitorDetail}" FontSize="13" Foreground="{DynamicResource Body}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Classes="pbtn pri" Margin="10,0,0,0" Command="{Binding AbortRunCommand}"
                IsVisible="{Binding IsRunningProgram}" Content="立即停止" />
        <Button Grid.Column="2" Classes="pbtn" Margin="10,0,0,0" Command="{Binding CloseRunMonitorCommand}"
                IsVisible="{Binding RunMonitorCanClose}" Content="返回程序" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
