<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ParallelReactor.ViewModels"
             xmlns:ctl="using:ParallelReactor.Controls"
             x:Class="ParallelReactor.Controls.GraphView"
             x:CompileBindings="False"
             x:DataType="vm:GraphViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- 标题 -->
    <Grid Grid.Row="0" Margin="20,14,20,6" ColumnDefinitions="Auto,*">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Bottom">
        <TextBlock Text="实时曲线" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" />
        <TextBlock Text="LIVE CURVES · 多通道叠加" FontSize="9" FontWeight="Medium" VerticalAlignment="Bottom"
                   Foreground="{DynamicResource Body}" LetterSpacing="2" Margin="0,0,0,1" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="点击右侧通道可切换显示" FontSize="11" HorizontalAlignment="Right"
                 Foreground="{DynamicResource Mute}" VerticalAlignment="Bottom" />
    </Grid>

    <!-- 主体：左图 + 右侧栏 -->
    <Grid Grid.Row="1" Margin="18,4,18,14" ColumnDefinitions="*,236">

      <!-- 左：图表 -->
      <Border Grid.Column="0" Classes="graphcol" Margin="0,0,12,0" Padding="14">
        <DockPanel>
          <!-- 工具栏 -->
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource GlassLine}" BorderThickness="0,0,0,1"
                  Padding="0,0,0,10" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="ctab" Classes.on="{Binding RangeIs5}" Command="{Binding SetRangeCommand}" CommandParameter="5" Content="5 分钟" />
                <Button Classes="ctab" Classes.on="{Binding RangeIs15}" Command="{Binding SetRangeCommand}" CommandParameter="15" Content="15 分钟" />
                <Button Classes="ctab" Classes.on="{Binding RangeIs60}" Command="{Binding SetRangeCommand}" CommandParameter="60" Content="1 小时" />
                <Button Classes="ctab" Classes.on="{Binding RangeIsAll}" Command="{Binding SetRangeCommand}" CommandParameter="all" Content="全程" />
                <Border Width="1" Height="18" Background="{DynamicResource GlassLine}" Margin="4,0" />
                <Button Classes="ctab" Classes.on="{Binding MetricIsT}" Command="{Binding SetMetricCommand}" CommandParameter="T" Content="温度" />
                <Button Classes="ctab" Classes.on="{Binding MetricIsP}" Command="{Binding SetMetricCommand}" CommandParameter="P" Content="压力" />
                <Button Classes="ctab" Classes.on="{Binding MetricIsGas}" Command="{Binding SetMetricCommand}" CommandParameter="gas" Content="气体" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="gbtn" Command="{Binding AutoRangeCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M3 8V5a2 2 0 0 1 2-2h3 M21 8V5a2 2 0 0 0-2-2h-3 M3 16v3a2 2 0 0 0 2 2h3 M21 16v3a2 2 0 0 1-2 2h-3" Stroke="{DynamicResource Body}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                    <TextBlock Text="自适应" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="gbtn" Command="{Binding ExportCsvCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3" Stroke="{DynamicResource Body}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                    <TextBlock Text="导出 CSV" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="gbtn" Command="{Binding ScreenshotCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6 9V2h12v7 M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2 M6 14h12v8H6z" Stroke="{DynamicResource Body}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                    <TextBlock Text="截图" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <!-- 图例（底部）-->
          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Legend}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,4" VerticalAlignment="Center">
                  <Border Width="11" Height="3" CornerRadius="1.5" Background="{Binding Color}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Body}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 曲线画布 -->
          <Border Classes="graphcanvas">
            <ctl:GraphControl x:Name="Chart" />
          </Border>
        </DockPanel>
      </Border>

      <!-- 右：侧栏 -->
      <Border Grid.Column="1" Classes="graphcol" Padding="13">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="通道" Classes="gsect" />
            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="chtog" Classes.off="{Binding IsDim}" Command="{Binding ToggleCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Ellipse Grid.Column="0" Width="11" Height="11" VerticalAlignment="Center"
                               Fill="{Binding Dot}" Stroke="{Binding DotBorder}" StrokeThickness="1" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource OnDark}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding ValText}" FontSize="10.5"
                                 Foreground="{DynamicResource Body}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="分析（自动）" Classes="gsect" Margin="0,14,0,8" />
            <Border Background="{DynamicResource Glass}" CornerRadius="9" Padding="11,10">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="平均反应速率" FontSize="11" Foreground="{DynamicResource Body}" />
                  <TextBlock Grid.Column="1" Text="{Binding AvgRate}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="8 通道 mmol rsd" FontSize="11" Foreground="{DynamicResource Body}" />
                  <TextBlock Grid.Column="1" Text="{Binding Rsd}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GreenBright}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="温度最大偏差" FontSize="11" Foreground="{DynamicResource Body}" />
                  <TextBlock Grid.Column="1" Text="{Binding MaxDev}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnDark}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
