<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 对话框（mock 没有，复用 .panel / .panel-heading / .property-card 行 / .edit-plan 按钮的语言）与 .panel-backdrop -->
  <Style Selector="Border.backdrop">
    <Setter Property="Background" Value="{DynamicResource Backdrop}" />
    <Setter Property="ZIndex" Value="40" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Width" Value="300" />
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ExpandedLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 10 45 0 #40000000" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ZIndex" Value="60" />
  </Style>
  <Style Selector="Grid.dialog-row">
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="14,0,13,0" />
  </Style>
  <Style Selector="Border.dialog-line">
    <Setter Property="BorderBrush" Value="{DynamicResource PropertyLine}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Margin" Value="14,0,13,0" />
  </Style>
  <Style Selector="Grid.dialog-row TextBlock.k">
    <Setter Property="FontSize" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource Status}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.dialog-row TextBlock.v">
    <Setter Property="FontSize" Value="8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Grid.dialog-row TextBox.flat">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Height" Value="17" />
  </Style>
  <Style Selector="TextBlock.dialog-status">
    <Setter Property="FontSize" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource Status}" />
    <Setter Property="Margin" Value="14,8,13,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.dialog-status.error">
    <Setter Property="Foreground" Value="{DynamicResource Fail}" />
  </Style>
  <Style Selector="TextBlock.dialog-status.ok">
    <Setter Property="Foreground" Value="{DynamicResource Pass}" />
  </Style>
  <Style Selector="StackPanel.dialog-buttons">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="2,4,2,2" />
  </Style>
  <Style Selector="StackPanel.dialog-buttons Button.edit-plan">
    <Setter Property="Width" Value="80" />
    <Setter Property="Margin" Value="5,7" />
  </Style>

  <!-- 芯片（记住令牌 / 通道选择） -->
  <Style Selector="ToggleButton.channel-chip">
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BtnLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource White}" />
    <Setter Property="FontSize" Value="8" />
  </Style>
  <Style Selector="ToggleButton.channel-chip:checked">
    <Setter Property="Foreground" Value="{DynamicResource ChipActiveText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveLine}" />
  </Style>
  <Style Selector="ToggleButton.channel-chip:checked /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource ChipActiveBg}" />
  </Style>
  <Style Selector="ToggleButton.channel-chip:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Disabled}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleButton.channel-chip:disabled /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource DisabledBg}" />
  </Style>
</Styles>
