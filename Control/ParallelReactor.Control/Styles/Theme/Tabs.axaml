<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:ParallelReactor.Control.Controls"
                    xmlns:pr="using:ParallelReactor.Control.Controls.Pr"
                    xmlns:b="using:ParallelReactor.Control.Behaviors">
  <!-- 融合版 F1：分段项 / 分段控件、面板标题页签、芯片按样稿 main-fusion.html 改了样子（见各主题的注释）。pc-v3 外壳的图标栏项、文档页签（PrSideItem / PrDocTab）随 F2 删掉了。
       切换类（PORT-PLAN §4.6 的 ToggleButton 主题）：分段项 PrSegItem、面板标题页签 PrPTab、芯片 PrChip；
       以及 SegControl / PTabs / Chip 这几个模板控件的默认主题。样稿 base.css .pr-seg / .pr-ptab / .pr-chip。
       红点只表示未确认的错误报警（b:Pr.Dot）；计数是中性的（b:Pr.Count）。 -->


  <!-- 分段项（样稿 .segs2 span，直角细边的分段开关）：13 px 常规 t-2、左右 12、最小宽 40；段与段之间 1 px line-soft 竖线（第一段没有）；
       悬停 a-wash 底 + 品牌蓝字，按下 a-soft；当前 = 品牌蓝实心 + 白字 600；焦点环画在内侧 -->
  <ControlTheme x:Key="PrSegItem" TargetType="ToggleButton">
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource T2Brush}" />
    <Setter Property="FontSize" Value="{StaticResource FsBase}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ToolTip.ShowDelay" Value="400" />
    <Setter Property="ToolTip.BetweenShowDelay" Value="300" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Body" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
              <Ellipse Name="PART_Dot" Width="8" Height="8" Margin="7,0,0,0" Fill="{StaticResource RBrush}" VerticalAlignment="Center"
                       IsVisible="{TemplateBinding (b:Pr.Dot)}" />
            </StackPanel>
          </Border>
          <Border Name="PART_Focus" BorderThickness="2" BorderBrush="{StaticResource FocusBrush}" CornerRadius="{TemplateBinding CornerRadius}"
                  IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:nth-child(1)">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource AWashBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ABrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{StaticResource ASoftBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{StaticResource ABrush}" />
      <Setter Property="Foreground" Value="{StaticResource TInvBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Focus">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled, ^:reason">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TDisBrush}" />
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>

  <!-- 分段控件外框（样稿 .segs2）：高 28、白底、1 px line-2、圆角 3（裁剪：当前段的品牌蓝底不出圆角）、没有内边距、段间 1 px 竖线（由分段项画） -->
  <ControlTheme x:Key="{x:Type pr:SegControl}" TargetType="pr:SegControl">
    <Setter Property="Height" Value="{StaticResource SegH}" />
    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusS}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}" ClipToBounds="True">
          <StackPanel Name="PART_Host" Orientation="Horizontal" Spacing="0" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- 面板标题页签（样稿 .board.pg .ctabs span）：高 = 标题栏 − 1（41），14 px 常规 t-2；悬停 bg-hover + 品牌蓝字，按下 bg-press；当前品牌蓝 600 + 2 px 品牌蓝下划线；
       红点 8 px（未确认的错误报警），数字 = 中性小块（bg-sunken、13 px 500 t-2，圆角 10） -->
  <ControlTheme x:Key="PrPTab" TargetType="ToggleButton">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource T2Brush}" />
    <Setter Property="FontSize" Value="{StaticResource FsCell}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ToolTip.ShowDelay" Value="400" />
    <Setter Property="ToolTip.BetweenShowDelay" Value="300" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Body" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
              <Ellipse Name="PART_Dot" Width="8" Height="8" Margin="7,0,0,0" Fill="{StaticResource RBrush}" VerticalAlignment="Center"
                       IsVisible="{TemplateBinding (b:Pr.Dot)}" />
              <Border Name="PART_Count" MinWidth="20" Height="20" Margin="7,0,0,0" Padding="6,0" CornerRadius="10"
                      Background="{StaticResource BgSunkenBrush}" VerticalAlignment="Center"
                      IsVisible="{TemplateBinding (b:Pr.Count), Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{TemplateBinding (b:Pr.Count)}" Classes="num" FontSize="{StaticResource FsNum}" FontWeight="Medium"
                           Foreground="{StaticResource T2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>
          <Border Name="PART_Under" Height="2" VerticalAlignment="Bottom" Background="{StaticResource ABrush}" IsVisible="False" />
          <Border Name="PART_Focus" BorderThickness="2" BorderBrush="{StaticResource FocusBrush}" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ABrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{StaticResource BgPressBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{StaticResource ABrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Under">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Focus">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled, ^:reason">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TDisBrush}" />
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type pr:PTabs}" TargetType="pr:PTabs">
    <Setter Property="Height" Value="41" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Name="PART_Host" Orientation="Horizontal" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- 芯片（样稿 .res .vp / #pCurve .lgc 的圆角小块）：高 26、全圆（13）、1 px line-soft、白底、13 px t-2；悬停 a-line 边 + a-wash，按下 a-soft；开 a-tint + a-line + t-1 600（图标品牌蓝）；
       数字 t-3；禁用 t-dis + bg-sunken + line-faint -->
  <ControlTheme x:Key="PrChip" TargetType="ToggleButton">
    <!-- 不裁剪：焦点环 / 阴影画在控件外面（Avalonia 11.1 的模板控件默认 ClipToBounds=true） -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Height" Value="{StaticResource ChipH}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
    <Setter Property="Foreground" Value="{StaticResource T2Brush}" />
    <Setter Property="FontSize" Value="{StaticResource FsBase}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ToolTip.ShowDelay" Value="400" />
    <Setter Property="ToolTip.BetweenShowDelay" Value="300" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <c:IconView Name="PART_Icon" Icon="{TemplateBinding (b:Pr.Icon)}" Size="14" Foreground="{StaticResource T3Brush}"
                          VerticalAlignment="Center"
                          IsVisible="{TemplateBinding (b:Pr.Icon), Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
              <TextBlock Name="PART_Count" Text="{TemplateBinding (b:Pr.Count)}" Classes="num" Foreground="{StaticResource T3Brush}"
                         VerticalAlignment="Center"
                         IsVisible="{TemplateBinding (b:Pr.Count), Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>
          <Border Name="PART_Focus" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource FocusBrush}" CornerRadius="16"
                  IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource ALineBrush}" />
      <Setter Property="Background" Value="{StaticResource AWashBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{StaticResource ASoftBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{StaticResource T1Brush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{StaticResource ATintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ALineBrush}" />
    </Style>
    <Style Selector="^:checked /template/ c|IconView#PART_Icon">
      <Setter Property="Foreground" Value="{StaticResource ABrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Focus">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled, ^:reason">
      <Setter Property="Foreground" Value="{StaticResource TDisBrush}" />
      <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineFaintBrush}" />
      <Setter Property="Cursor" Value="No" />
    </Style>
    <Style Selector="^:disabled /template/ c|IconView#PART_Icon, ^:reason /template/ c|IconView#PART_Icon">
      <Setter Property="Foreground" Value="{StaticResource TDisBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type pr:Chip}" TargetType="pr:Chip" BasedOn="{StaticResource PrChip}" />



</ResourceDictionary>
