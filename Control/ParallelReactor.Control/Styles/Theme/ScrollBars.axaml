<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 细滚动条（PORT-PLAN §4.6；样稿 reactor.css 的 ::-webkit-scrollbar：8 px，拇指 line 色、圆角 4，悬停 line-strong）。
       完整模板，不叠在 Fluent 模板上；M2 起是 ScrollViewer / ScrollBar 的默认主题（Styles/Theme/Defaults.axaml）；旧界面（LegacyHost）里换回 Fluent 的，旧的滚动条样式只作用于 .legacy 子树。
       ScrollBar 放在 ScrollViewer 模板里时自己绑定 Maximum / Value / ViewportSize / Visibility（Avalonia 11 的 ScrollBar 行为）。 -->

  <ControlTheme x:Key="PrScrollThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="4" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource LineStrongBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{StaticResource LineStrongBrush}" />
    </Style>
  </ControlTheme>

  <!-- 轨道上点一下翻页的透明按钮 -->
  <ControlTheme x:Key="PrScrollPage" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="PrScrollBar" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="{TemplateBinding Orientation}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource PrScrollPage}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource PrScrollPage}" />
            </Track.IncreaseButton>
            <Thumb Name="PART_Thumb" Theme="{StaticResource PrScrollThumb}" />
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="8" />
    </Style>
    <Style Selector="^:vertical /template/ Track#PART_Track">
      <Setter Property="IsDirectionReversed" Value="True" />
    </Style>
    <Style Selector="^:vertical /template/ Thumb#PART_Thumb">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="^:horizontal /template/ Thumb#PART_Thumb">
      <Setter Property="MinWidth" Value="24" />
    </Style>
  </ControlTheme>

  <!-- 细的浮层滚动条（4 px，没有轨道底色）：画在内容上、不占布局宽度（PrScrollViewerOverlay） -->
  <ControlTheme x:Key="PrScrollBarThin" TargetType="ScrollBar" BasedOn="{StaticResource PrScrollBar}">
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="4" />
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="4" />
    </Style>
  </ControlTheme>

  <!-- 浮层滚动区（样稿的资源管理器树：macOS 的浮层滚动条，不留滚动条的位置 —— 16 路设备展开后，RV 行的状态字列照样有 ≥ 60 px）：
       滚动条 4 px，贴在右边（离边 1 px），落在行的右内边距里，不压字；指针移上来才显示 -->
  <ControlTheme x:Key="PrScrollViewerOverlay" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ScrollContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}" />
          <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Theme="{StaticResource PrScrollBarThin}"
                     VerticalAlignment="Bottom" Margin="2,0,2,1" />
          <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Theme="{StaticResource PrScrollBarThin}"
                     HorizontalAlignment="Right" Margin="0,2,1,2" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- 同 macOS 的浮层滚动条：指针不在滚动区上时不画（底部的渐隐已经说明下面还有） -->
    <Style Selector="^ /template/ ScrollBar">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:pointerover /template/ ScrollBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <!-- 滚动区：内容在左上格，滚动条各占 8 px（同网页的经典滚动条，不浮在内容上） -->
  <ControlTheme x:Key="PrScrollViewer" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
          <ScrollContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}" />
          <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Theme="{StaticResource PrScrollBar}" />
          <ScrollBar Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Theme="{StaticResource PrScrollBar}" />
          <Panel Name="PART_ScrollBarsSeparator" Grid.Row="1" Grid.Column="1" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
