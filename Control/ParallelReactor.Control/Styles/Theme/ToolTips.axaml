<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 悬停提示 PrTip（融合版 F1；样稿 main-fusion.html .ctip）：白底 + 1 px line-strong 边、13 px t-2、行高 19、内边距 7 10、GBG 直角（圆角 2）、最宽 400、ShadowTip。
       显示延时是挂在宿主控件上的附加属性（ToolTip.ShowDelay 400 / BetweenShowDelay 300）：Pr 主题的可交互控件都设了；
       原因提示（Behaviors/Reason.cs）直接给出套了本主题的 ToolTip，前面一个 14 px 锁图标。
       本主题是全局的 ToolTip 默认主题（Styles/Theme/Defaults.axaml，M2）；旧界面（LegacyHost）里换回 Fluent 的。 -->
  <ControlTheme x:Key="PrTip" TargetType="ToolTip">
    <!-- 不裁剪：焦点环 / 阴影画在控件外面（Avalonia 11.1 的模板控件默认 ClipToBounds=true） -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource T2Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FsBase}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusStep}" />
    <Setter Property="MaxWidth" Value="400" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="{StaticResource ShadowTip}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            TextWrapping="Wrap"
                            LineHeight="19" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
