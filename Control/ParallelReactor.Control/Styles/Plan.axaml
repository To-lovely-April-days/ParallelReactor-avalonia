<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- .plan-canvas / .step-card / .duration / .flow-link / .canvas-divider / .hardware-check / .hardware-note -->
  <Style Selector="Border.plan-canvas">
    <Setter Property="Background" Value="{DynamicResource Canvas}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.plan-canvas-sheen">
    <Setter Property="Background" Value="{DynamicResource CanvasGradient}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="Border.step-card">
    <Setter Property="Height" Value="185" />
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 1 5 0 #12282832" />
    <Setter Property="ZIndex" Value="1" />
  </Style>
  <Style Selector="Border.step-card.green">
    <Setter Property="Background" Value="{DynamicResource GreenCardGradient}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GreenCardLine}" />
  </Style>
  <Style Selector="Border.step-card.editing">
    <Setter Property="BoxShadow" Value="0 0 0 1 #a999da, 0 2 8 0 #213c2d64" />
  </Style>
  <Style Selector="Border.step-card.current">
    <Setter Property="BorderBrush" Value="{DynamicResource DotCurLine}" />
  </Style>
  <Style Selector="Border.step-title">
    <Setter Property="Height" Value="27" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardSection}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.step-title TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.step-section">
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="9,7,9,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardSection}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.step-section.last">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBlock.device-label">
    <Setter Property="FontSize" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource Label}" />
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>
  <Style Selector="TextBlock.device-mode">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Margin" Value="0,0,0,7" />
  </Style>
  <Style Selector="TextBlock.setpoint-label">
    <Setter Property="FontSize" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource Label2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.step-value">
    <Setter Property="FontSize" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.duration">
    <Setter Property="Height" Value="29" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource Duration}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SoftLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ZIndex" Value="1" />
  </Style>
  <Style Selector="Border.duration TextBlock">
    <Setter Property="FontSize" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.duration TextBlock.strong">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Rectangle.duration-tick">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Fill" Value="{DynamicResource DurationTick}" />
  </Style>
  <Style Selector="Rectangle.flow-link">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{DynamicResource FlowLine}" />
  </Style>
  <Style Selector="Path.flow-arrow">
    <Setter Property="Fill" Value="{DynamicResource FlowLine}" />
    <Setter Property="Data" Value="M0,0 L4,2 L0,4 Z" />
  </Style>
  <Style Selector="Rectangle.canvas-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{DynamicResource Divider}" />
  </Style>
  <Style Selector="Border.hardware-check">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="{DynamicResource Timeline}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SoftLine}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.hardware-check TextBlock">
    <Setter Property="FontSize" Value="7" />
  </Style>
  <Style Selector="Border.hardware-check TextBlock.strong">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.hardware-elbow">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="22" />
    <Setter Property="BorderBrush" Value="{DynamicResource FlowLine}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
  </Style>
  <Style Selector="Border.hardware-note">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Background" Value="{DynamicResource White}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardLine}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.hardware-note TextBlock">
    <Setter Property="FontSize" Value="8" />
  </Style>

  <!-- 总览格 -->
  <Style Selector="Border.overview-tile">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 1 5 0 #12282832" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.overview-tile.disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Border.overview-tile.running">
    <Setter Property="Background" Value="{DynamicResource GreenCardGradient}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GreenCardLine}" />
  </Style>
</Styles>
