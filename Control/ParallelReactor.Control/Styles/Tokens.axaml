  <SolidColorBrush x:Key="AxSegBrush" Color="{StaticResource AxSegColor}" />
  <!-- 焦点：边框 = a；焦点环 = a × 0.12（.inp:focus） -->
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource AColor}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource AColor}" Opacity="0.12" />
  <!-- 语义画刷（新概念：面板、竖条、工具条、菜单栏、运行表、报警弹窗、开关、滚动条）：只指向色板里的颜色 -->
  <!-- 面板 -->
  <SolidColorBrush x:Key="PaneBgBrush" Color="{StaticResource BgCardColor}" />
  <SolidColorBrush x:Key="PaneLineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="PaneHeadBrush" Color="{StaticResource BgHeadColor}" />
  <SolidColorBrush x:Key="PaneHeadLineBrush" Color="{StaticResource LineSoftColor}" />
  <SolidColorBrush x:Key="PaneTitleBrush" Color="{StaticResource T1Color}" />
  <SolidColorBrush x:Key="DockBgBrush" Color="{StaticResource BgAppColor}" />
  <!-- 竖条 -->
  <SolidColorBrush x:Key="RailBgBrush" Color="{StaticResource BgPanelColor}" />
  <SolidColorBrush x:Key="RailLineBrush" Color="{StaticResource LineSoftColor}" />
  <SolidColorBrush x:Key="RailInkBrush" Color="{StaticResource T2Color}" />
  <SolidColorBrush x:Key="RailBtnBrush" Color="{StaticResource TIconColor}" />
  <!-- 工具条 -->
  <SolidColorBrush x:Key="RibbonBgBrush" Color="{StaticResource BgCardColor}" />
  <SolidColorBrush x:Key="RibbonLineBrush" Color="{StaticResource LineSoftColor}" />
  <SolidColorBrush x:Key="RibbonBtnLineBrush" Color="{StaticResource LineStrongColor}" />
  <SolidColorBrush x:Key="RibbonSepBrush" Color="{StaticResource LineSepColor}" />
  <SolidColorBrush x:Key="RibbonIconBrush" Color="{StaticResource GbgIconColor}" />
  <!-- 标题条 -->
  <SolidColorBrush x:Key="StripInkBrush" Color="{StaticResource SideInkColor}" />
  <!-- 菜单栏 -->
  <SolidColorBrush x:Key="MenuInkBrush" Color="{StaticResource GbgMenuColor}" />
  <SolidColorBrush x:Key="MenuOnBrush" Color="{StaticResource AColor}" />
  <SolidColorBrush x:Key="MenuBadgeBrush" Color="{StaticResource RColor}" />
  <!-- 运行表 -->
  <SolidColorBrush x:Key="RunHeadInkBrush" Color="{StaticResource T3Color}" />
  <SolidColorBrush x:Key="RunSubBrush" Color="{StaticResource T4Color}" />
  <SolidColorBrush x:Key="RunRowLineBrush" Color="{StaticResource LineFaintColor}" />
  <SolidColorBrush x:Key="RunRowHoverBrush" Color="{StaticResource BgHoverColor}" />
  <SolidColorBrush x:Key="RunRowSelBrush" Color="{StaticResource ATintColor}" />
  <SolidColorBrush x:Key="RunRowErrBrush" Color="{StaticResource RBgColor}" />
  <SolidColorBrush x:Key="RunRowErrSelBrush" Color="{StaticResource RSoftColor}" />
  <SolidColorBrush x:Key="RunStepDoneBrush" Color="{StaticResource ADoneColor}" />
  <SolidColorBrush x:Key="RunStepTrackBrush" Color="{StaticResource ATrackColor}" />
  <SolidColorBrush x:Key="RunStepNextBrush" Color="{StaticResource BgPressColor}" />
  <SolidColorBrush x:Key="RunStepFillBrush" Color="{StaticResource AColor}" />
  <!-- 报警弹窗 -->
  <SolidColorBrush x:Key="ApopEdgeBrush" Color="{StaticResource RColor}" />
