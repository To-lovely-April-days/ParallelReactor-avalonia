  <SolidColorBrush x:Key="ApopBadBrush" Color="{StaticResource RBgColor}" />
  <SolidColorBrush x:Key="ApopBadLineBrush" Color="{StaticResource RLineColor}" />
  <SolidColorBrush x:Key="ApopInfoBrush" Color="{StaticResource AWashColor}" />
  <SolidColorBrush x:Key="ApopFootBrush" Color="{StaticResource BgHeadColor}" />
  <!-- 开关 -->
  <SolidColorBrush x:Key="ToggleOffBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="ToggleOnBrush" Color="{StaticResource AColor}" />
  <SolidColorBrush x:Key="ToggleKnobBrush" Color="{StaticResource BgCardColor}" />
  <!-- 滚动条 -->
  <SolidColorBrush x:Key="ScrollTrackBrush" Color="{StaticResource BgBarColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource LineSepColor}" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource LineFirmColor}" />
  <!-- 阴影（CSS「x y blur rgba」→ Avalonia BoxShadows「x y blur spread #aarrggbb」，多层用逗号） -->
  <BoxShadows x:Key="ShadowCard">0 1 2 0 #0a101828</BoxShadows>
  <BoxShadows x:Key="ShadowCardHover">0 2 10 0 #1c101828</BoxShadows>
  <BoxShadows x:Key="ShadowStep">0 1 5 0 #12101828</BoxShadows>
  <BoxShadows x:Key="ShadowPop">0 10 30 0 #33000000</BoxShadows>
  <BoxShadows x:Key="ShadowDlg">0 24 60 0 #47111827, 0 2 8 0 #1f111827</BoxShadows>
  <BoxShadows x:Key="ShadowModal">0 10 30 0 #38142032</BoxShadows>
  <BoxShadows x:Key="ShadowFloat">0 10 32 0 #38000000</BoxShadows>
  <BoxShadows x:Key="ShadowTip">0 4 14 0 #24000000</BoxShadows>
  <BoxShadows x:Key="ShadowToast">0 6 18 0 #29142032</BoxShadows>
  <BoxShadows x:Key="ShadowKnob">0 1 2 0 #33000000</BoxShadows>
  <BoxShadows x:Key="ShadowDotRun">0 0 0 3 #242e8b3e</BoxShadows>
  <BoxShadows x:Key="ShadowDotErr">0 0 0 3 #29c62828</BoxShadows>
  <BoxShadows x:Key="ShadowAxElev">0 16 40 0 #29101828, 0 3 8 0 #14101828, 0 0 0 1 #12101828</BoxShadows>
  <BoxShadows x:Key="ShadowAxElevS">0 6 18 0 #24101828, 0 0 0 1 #12101828</BoxShadows>
  <BoxShadows x:Key="ShadowAxSegCur">0 1 3 0 #1f101828</BoxShadows>
  <BoxShadows x:Key="ShadowDotBrand">0 0 0 3 #24204797</BoxShadows>
  <BoxShadows x:Key="FocusRingShadow">0 0 0 3 #1f204797</BoxShadows>
  <!-- END GENERATED COLORS -->

  <!-- 渐变（只用令牌颜色） -->
  <!-- 窗口内的深蓝条（样稿 .titlebar：linear-gradient(tb-a, tb-b)，180°） -->
  <LinearGradientBrush x:Key="SideGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="{StaticResource Side1Color}" />
    <GradientStop Offset="1" Color="{StaticResource Side2Color}" />
  </LinearGradientBrush>
  <!-- 当前步骤卡片（旧页面）：品牌蓝浅底，不用薄荷绿（样稿「程序卡：当前步骤 = 品牌蓝左边线 + 浅底标题」） -->
  <LinearGradientBrush x:Key="StepActiveGradientBrush" StartPoint="0%,37%" EndPoint="100%,63%">
    <GradientStop Offset="0" Color="{StaticResource AWashColor}" />
    <GradientStop Offset="1" Color="{StaticResource ATintColor}" />
  </LinearGradientBrush>
  <!-- 进度（样稿 .rtab .pgb）：已完成 a-done；运行中 = 品牌蓝实心（两端同色，键名沿用） -->
  <LinearGradientBrush x:Key="ProgressDoneGradientBrush" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="{StaticResource ADoneColor}" />
    <GradientStop Offset="1" Color="{StaticResource ADoneColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ProgressRunGradientBrush" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="{StaticResource AColor}" />
    <GradientStop Offset="1" Color="{StaticResource AColor}" />
  </LinearGradientBrush>

  <!-- 字体（pc-v3 §4.3；样稿的 font 变量是 "Segoe UI Variable Text","Segoe UI",…,"PingFang SC","Microsoft YaHei UI"）：这里是产品目标 Windows 的栈；App.Initialize 在创建窗口前按系统写入 Application.Resources["UiFont"] -->
  <FontFamily x:Key="UiFont">Segoe UI, fonts:Cjk#Microsoft YaHei UI, fonts:Cjk#Microsoft YaHei, fonts:Inter#Inter</FontFamily>
  <!-- 只含中文字体（Theme/UiFonts.CjkStack）：字重混排的中文 Run 显式用它，绕过 Avalonia 11.1 回退沿用上一段字重的缺陷 -->
  <FontFamily x:Key="UiFontCjk">fonts:Cjk#Microsoft YaHei UI, fonts:Cjk#Microsoft YaHei</FontFamily>

  <!-- 字号、行高、外框、控件尺寸、间距、圆角、过渡：任何文字 ≥ 13 px（融合版中文同样 ≥ 13）。
       行高：Avalonia 的 LineHeight 是绝对值、会继承：只在多行文字、上下堆叠的文字上显式设置，单行居中的文字不用设。
       根元素带 .frozen（演示冻结、截图）时不要过渡和动画（Theme/Frozen.cs） -->
  <!-- BEGIN GENERATED SIZES（Control/tools/gen-tokens.py ← tools/fusion-tokens.json（样稿 research/main-fusion.html）；不要手改，改 JSON 后重新生成） -->
