  <x:Double x:Key="FsMenuNarrow">22</x:Double>  <!-- 宽 < 1600 时 .mi 22 -->
  <x:Double x:Key="FsCap">20</x:Double>  <!-- .cap .cl 胶囊里的设备名 -->
