  <x:Double x:Key="FsDevName">20</x:Double>  <!-- .dv .nm 设备名 20/300 -->
  <x:Double x:Key="FsDevAll">17</x:Double>  <!-- .dv.all .nm「总览」17 -->
  <x:Double x:Key="FsInspTitle">24</x:Double>  <!-- 检查器标题 24/300 -->
