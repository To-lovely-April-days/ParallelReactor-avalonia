<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ParallelReactor.Control.ViewModels"
             xmlns:c="using:ParallelReactor.Control.Controls"
             x:Class="ParallelReactor.Control.Views.ReactorListView"
             x:DataType="vm:MainViewModel">
  <!-- .reactor-list：8 行 × 32px，RV5–RV8 未安装灰显 -->
  <Border Classes="reactor-list">
    <ItemsControl ItemsSource="{Binding Channels}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:ChannelVm">
          <Border Classes="reactor-row" Classes.disabled="{Binding !Installed}" Classes.alarm="{Binding AlarmCause, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="{Binding Name}" />
              <StackPanel Grid.Column="2" Classes="reactor-status" Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding ListStateText}" />
                <Border Classes="voltage" IsVisible="{Binding Installed}"><TextBlock Text="{Binding VoltageText}" /></Border>
                <c:IconView Geometry="{StaticResource IcoGauge}" Size="10" Foreground="{DynamicResource Status}" IsVisible="{Binding Installed}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>
