<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ParallelReactor.Control.ViewModels"
             xmlns:v="using:ParallelReactor.Control.Views"
             xmlns:c="using:ParallelReactor.Control.Controls"
             x:Class="ParallelReactor.Control.Views.TimelineView"
             x:DataType="vm:MainViewModel">
  <!-- .timeline：头 24px（时间标签 + 缩放）+ 轨道（自绘）+ 112px 操作列 -->
  <Border Classes="timeline">
    <Grid RowDefinitions="24,*">
      <Border Classes="timeline-head">
        <Panel>
          <Grid ColumnDefinitions="*,112"><c:TimelineHead T1="{Binding T1}" T2="{Binding T2}" T3="{Binding T3}" T4="{Binding T4}" Margin="9,0,0,0" /></Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,6,0">
            <Button Classes="flat icon-button" ToolTip.Tip="放大" Command="{Binding NotImplementedCommand}" CommandParameter="时间轴放大"><c:IconView Geometry="{StaticResource IcoSearch}" Size="10" /></Button>
            <Button Classes="flat icon-button" ToolTip.Tip="缩小" Command="{Binding NotImplementedCommand}" CommandParameter="时间轴缩小"><c:IconView Geometry="{StaticResource IcoZoomOut}" Size="10" /></Button>
          </StackPanel>
        </Panel>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="*,112">
        <c:TimelineTracks Rows="{Binding TimelineRows}" BookIcon="{StaticResource IcoBook}" ClipToBounds="True" />
        <Border Grid.Column="1" Classes="track-actions">
          <ItemsControl ItemsSource="{Binding TimelineRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TimelineRowVm">
                <Border Classes="action-row" Classes.disabled="{Binding Disabled}">
                  <UniformGrid Columns="6">
                    <Ellipse Classes="status-dot" Classes.running="{Binding Channel.IsRunning}" HorizontalAlignment="Center" />
                    <Button Classes="flat icon-button action" Classes.active="{Binding Running}" ToolTip.Tip="{Binding PlayTitle}" HorizontalAlignment="Center"
                            Command="{Binding $parent[v:TimelineView].((vm:MainViewModel)DataContext).RowPlayCommand}" CommandParameter="{Binding Channel}"><c:IconView Geometry="{StaticResource IcoPlay}" Size="8" /></Button>
                    <Button Classes="flat icon-button action" ToolTip.Tip="停止" HorizontalAlignment="Center"
                            Command="{Binding $parent[v:TimelineView].((vm:MainViewModel)DataContext).RowStopCommand}" CommandParameter="{Binding Channel}"><c:IconView Geometry="{StaticResource IcoStop}" Size="8" /></Button>
                    <Button Classes="flat icon-button action" ToolTip.Tip="下一步" HorizontalAlignment="Center"
                            Command="{Binding $parent[v:TimelineView].((vm:MainViewModel)DataContext).RowSkipCommand}" CommandParameter="{Binding Channel}"><c:IconView Geometry="{StaticResource IcoSkip}" Size="8" /></Button>
                    <Button Classes="flat icon-button action" ToolTip.Tip="程序" HorizontalAlignment="Center"
                            Command="{Binding $parent[v:TimelineView].((vm:MainViewModel)DataContext).RowBookCommand}" CommandParameter="{Binding Channel}"><c:IconView Geometry="{StaticResource IcoBook}" Size="8" /></Button>
                    <Button Classes="flat icon-button action" ToolTip.Tip="下发" HorizontalAlignment="Center"
                            Command="{Binding $parent[v:TimelineView].((vm:MainViewModel)DataContext).RowUploadCommand}" CommandParameter="{Binding Channel}"><c:IconView Geometry="{StaticResource IcoUpload}" Size="8" /></Button>
                  </UniformGrid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
