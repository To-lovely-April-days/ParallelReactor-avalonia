<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ParallelReactor.Control.ViewModels"
             xmlns:v="using:ParallelReactor.Control.Views"
             xmlns:c="using:ParallelReactor.Control.Controls"
             x:Class="ParallelReactor.Control.Views.MainView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Border.toast"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Border.toast.visible"><Setter Property="Opacity" Value="1" /></Style>
  </UserControl.Styles>

  <Panel>
    <!-- ===== .app 网格：40 | minmax(455,1.04fr) | minmax(430,1fr) | 200 ; 24 | 35 | minmax(360,1fr) | 256 ===== -->
    <Grid Background="{DynamicResource Panel}" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="1.04*" MinWidth="455" />
        <ColumnDefinition Width="*" MinWidth="430" />
        <ColumnDefinition Width="200" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="24" />
        <RowDefinition Height="35" />
        <RowDefinition Height="*" MinHeight="360" />
        <RowDefinition Height="256" />
      </Grid.RowDefinitions>

      <!-- 菜单栏 -->
      <Border Classes="menubar" Grid.Row="0" Grid.ColumnSpan="4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal">
            <Button Classes="flat menu-item" Classes.open="{Binding MenuFileOpen}" Content="文件" Command="{Binding ToggleMenuCommand}" CommandParameter="file" />
            <Button Classes="flat menu-item" Classes.open="{Binding MenuEditOpen}" Content="编辑" Command="{Binding ToggleMenuCommand}" CommandParameter="edit" />
            <Button Classes="flat menu-item" Content="连接" Command="{Binding OpenConnectDialogCommand}" />
            <Button Classes="flat menu-item" Classes.open="{Binding MenuViewOpen}" Content="视图" Command="{Binding ToggleMenuCommand}" CommandParameter="view" />
            <Button Classes="flat menu-item" Classes.open="{Binding MenuWindowOpen}" Content="窗口" Command="{Binding ToggleMenuCommand}" CommandParameter="window" />
            <Button Classes="flat menu-item" Classes.open="{Binding MenuHelpOpen}" Content="帮助" Command="{Binding ToggleMenuCommand}" CommandParameter="help" />
          </StackPanel>
          <Border Grid.Column="1" Classes="estop-strip" IsVisible="{Binding EstopActive}" HorizontalAlignment="Left" Margin="10,2">
            <TextBlock Text="{Binding EstopText}" Foreground="White" FontSize="8" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <TextBlock Classes="status-text" Text="{Binding DeviceText}" />
            <TextBlock Classes="status-text" Text="{Binding ConnectionText}" />
            <Button Classes="flat" Command="{Binding OpenControlDialogCommand}" Cursor="Hand">
              <TextBlock Classes="control-badge" Classes.remote="{Binding ControlBadgeClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=remote}"
                         Classes.lost="{Binding ControlBadgeClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=lost}"
                         Classes.requesting="{Binding ControlBadgeClass, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=requesting}"
                         Text="{Binding ControlBadge}" />
            </Button>
            <Button Classes="flat menu-item estop" Content="急停" Command="{Binding AskEstopCommand}" IsEnabled="{Binding IsConnected}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 标签栏：40 | 1fr | 200 -->
      <Border Classes="tabbar" Grid.Row="1" Grid.ColumnSpan="4">
        <Grid ColumnDefinitions="40,*,200">
          <Border Classes="brand-cell">
            <c:IconView Geometry="{StaticResource IcoLogo}" Size="21" Stroke="1.8" Foreground="{DynamicResource Purple}" Width="17" />
          </Border>
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Tabs}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:TabVm">
                  <Panel>
                    <Button Classes="flat reactor-tab" Classes.active="{Binding IsActive}" IsVisible="{Binding IsReactorTab}" Content="{Binding Title}"
                            Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).SelectTabCommand}" CommandParameter="{Binding}" />
                    <Button Classes="flat utility-tab" IsVisible="{Binding !IsReactorTab}" Content="{Binding Title}"
                            Command="{Binding $parent[v:MainView].((vm:MainViewModel)DataContext).SelectTabCommand}" CommandParameter="{Binding}" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
              <Button Classes="flat add-tab" Content="+" Command="{Binding NotImplementedCommand}" CommandParameter="新标签" />
            </StackPanel>
            <Button Grid.Column="1" Classes="flat tab-more" Content="›" Command="{Binding NotImplementedCommand}" CommandParameter="更多标签" />
          </Grid>
          <Border Grid.Column="2" Classes="tab-corner" />
        </Grid>
      </Border>

      <!-- 侧栏 -->
      <Border Classes="sidebar" Grid.Row="2" Grid.Column="0">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Classes="flat side-button bottom" Command="{Binding NotImplementedCommand}" CommandParameter="收起"><c:IconView Geometry="{StaticResource IcoChevron}" Size="16" /></Button>
          <StackPanel>
            <Button Classes="flat side-button" Classes.active="{Binding IsMainView}" Command="{Binding ShowViewCommand}" CommandParameter="main" ToolTip.Tip="系统视图"><c:IconView Geometry="{StaticResource IcoFlask}" Size="16" /></Button>
            <Button Classes="flat side-button" Command="{Binding RefreshCommand}" ToolTip.Tip="刷新"><c:IconView Geometry="{StaticResource IcoRefresh}" Size="16" /></Button>
            <Button Classes="flat side-button" Command="{Binding NotImplementedCommand}" CommandParameter="历史记录" ToolTip.Tip="历史"><c:IconView Geometry="{StaticResource IcoClock}" Size="16" /></Button>
            <Button Classes="flat side-button" Command="{Binding NotImplementedCommand}" CommandParameter="程序库" ToolTip.Tip="程序"><c:IconView Geometry="{StaticResource IcoList}" Size="16" /></Button>
            <Button Classes="flat side-button" Classes.active="{Binding IsPerfView}" Command="{Binding ShowViewCommand}" CommandParameter="perf" ToolTip.Tip="性能测试"><c:IconView Geometry="{StaticResource IcoCheck}" Size="16" /></Button>
            <Button Classes="flat side-button" Command="{Binding OpenConnectDialogCommand}" ToolTip.Tip="设置"><c:IconView Geometry="{StaticResource IcoGear}" Size="16" /></Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 主视图：程序编辑器 / 全部曲线 / 总览 -->
      <v:PlanEditorView Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsPlanMode}" />
      <Border Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsCurvesMode}"><v:GraphView DataContext="{Binding AllChart}" PanelKey="curves" /></Border>
      <v:OverviewView Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsOverviewMode}" />

      <!-- 主视图右侧：属性查看器 200 + 曲线 -->
      <Grid Grid.Row="2" Grid.Column="2" RowDefinitions="200,*" IsVisible="{Binding IsMainView}">
        <v:PropertyViewerView />
        <v:GraphView Grid.Row="1" MinHeight="160" DataContext="{Binding Chart}" PanelKey="graph" />
      </Grid>

      <!-- 性能测试视图：左 测试项与通道 | 右 测试进度 55% + 实时曲线 45%（mock #perfPanel / #perfRight） -->
      <Border Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsPerfView}"><v:PerfChecklistView DataContext="{Binding Perf}" /></Border>
      <Grid Grid.Row="2" Grid.Column="2" RowDefinitions="55*,45*" IsVisible="{Binding IsPerfView}">
        <v:PerfProgressView DataContext="{Binding Perf}" />
        <v:GraphView Grid.Row="1" MinHeight="160" DataContext="{Binding Perf.Chart}" PanelKey="perfgraph" />
      </Grid>

      <!-- 检查器（列 4，跨 2 行） -->
      <v:InspectorView Grid.Row="2" Grid.RowSpan="2" Grid.Column="3" />

      <!-- 反应釜列表（40 + 78 = 118，叠在时间轴左侧） -->
      <v:ReactorListView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ZIndex="4" HorizontalAlignment="Left" />

      <!-- 时间轴 -->
      <v:TimelineView Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" />
    </Grid>

    <!-- ===== 覆盖层：菜单下拉 / 展开面板 / 对话框 / Toast ===== -->
    <Border Background="Transparent" IsVisible="{Binding OpenMenu, Converter={x:Static ObjectConverters.IsNotNull}}" Name="MenuCatcher" />
    <Canvas IsHitTestVisible="True">
      <Border Classes="menu-drop" Canvas.Left="7" Canvas.Top="23" IsVisible="{Binding MenuFileOpen}">
        <StackPanel>
          <Button Classes="flat menu-drop-item" Content="连接设备…" Command="{Binding OpenConnectDialogCommand}" />
          <Button Classes="flat menu-drop-item" Content="断开连接" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
          <Button Classes="flat menu-drop-item" Content="申请 / 释放控制权…" Command="{Binding OpenControlDialogCommand}" />
          <Button Classes="flat menu-drop-item" Content="退出" Command="{Binding ExitCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="menu-drop" Canvas.Left="44" Canvas.Top="23" IsVisible="{Binding MenuEditOpen}">
        <StackPanel>
          <Button Classes="flat menu-drop-item" Content="{Binding EditButtonText}" Command="{Binding ToggleEditCommand}" />
          <Button Classes="flat menu-drop-item" Content="下发程序" Command="{Binding UploadProgramCommand}" />
          <Button Classes="flat menu-drop-item" Content="导出" Command="{Binding ExportCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="menu-drop" Canvas.Left="118" Canvas.Top="23" IsVisible="{Binding MenuViewOpen}">
        <StackPanel>
          <Button Classes="flat menu-drop-item" Content="系统视图" Command="{Binding ShowViewCommand}" CommandParameter="main" />
          <Button Classes="flat menu-drop-item" Content="性能测试" Command="{Binding ShowViewCommand}" CommandParameter="perf" />
        </StackPanel>
      </Border>
      <Border Classes="menu-drop" Canvas.Left="155" Canvas.Top="23" IsVisible="{Binding MenuWindowOpen}">
        <StackPanel>
          <Button Classes="flat menu-drop-item" Content="展开程序编辑器" Command="{Binding ToggleExpandCommand}" CommandParameter="plan" />
          <Button Classes="flat menu-drop-item" Content="展开曲线" Command="{Binding ToggleExpandCommand}" CommandParameter="graph" />
          <Button Classes="flat menu-drop-item" Content="恢复全部属性" Command="{Binding RestorePropertiesCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="menu-drop" Canvas.Left="192" Canvas.Top="23" IsVisible="{Binding MenuHelpOpen}">
        <StackPanel>
          <Button Classes="flat menu-drop-item" Content="关于" Command="{Binding AboutCommand}" />
        </StackPanel>
      </Border>
    </Canvas>

    <!-- 展开面板 -->
    <Border Classes="backdrop" IsVisible="{Binding IsExpanded}" Name="Backdrop" />
    <Border Classes="panel expanded" IsVisible="{Binding IsPlanExpanded}"><v:PlanEditorView /></Border>
    <Border Classes="panel expanded" IsVisible="{Binding IsGraphExpanded}"><v:GraphView DataContext="{Binding Chart}" PanelKey="graph" /></Border>
    <Border Classes="panel expanded" IsVisible="{Binding IsPropertyExpanded}"><v:PropertyViewerView /></Border>
    <Border Classes="panel expanded" IsVisible="{Binding IsCurvesExpanded}"><v:GraphView DataContext="{Binding AllChart}" PanelKey="curves" /></Border>
    <Border Classes="panel expanded" IsVisible="{Binding IsPerfProgressExpanded}"><v:PerfProgressView DataContext="{Binding Perf}" /></Border>
    <Border Classes="panel expanded" IsVisible="{Binding IsPerfGraphExpanded}"><v:GraphView DataContext="{Binding Perf.Chart}" PanelKey="perfgraph" /></Border>

    <!-- 对话框 -->
    <Border Classes="backdrop" IsVisible="{Binding ConnectDialog.IsOpen}" />
    <Border Classes="dialog" IsVisible="{Binding ConnectDialog.IsOpen}">
      <StackPanel>
        <Border Classes="panel-heading">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Classes="breadcrumb"><c:IconView Geometry="{StaticResource IcoGear}" Size="10" /><TextBlock Classes="strong" Text="连接设备" /><TextBlock Classes="muted" Text="REST + WebSocket · Bearer 令牌" /></StackPanel>
            <StackPanel Grid.Column="1" Classes="heading-actions"><Button Classes="flat icon-button" Command="{Binding CloseConnectDialogCommand}"><c:IconView Geometry="{StaticResource IcoClose}" Size="10" /></Button></StackPanel>
          </Grid>
        </Border>
        <Border Classes="dialog-line"><Grid Classes="dialog-row" Margin="0" ColumnDefinitions="70,*"><TextBlock Classes="k" Text="地址" /><TextBox Grid.Column="1" Classes="flat" Text="{Binding ConnectDialog.Host}" /></Grid></Border>
        <Border Classes="dialog-line"><Grid Classes="dialog-row" Margin="0" ColumnDefinitions="70,*"><TextBlock Classes="k" Text="端口" /><TextBox Grid.Column="1" Classes="flat" Text="{Binding ConnectDialog.Port}" /></Grid></Border>
        <Border Classes="dialog-line"><Grid Classes="dialog-row" Margin="0" ColumnDefinitions="70,*"><TextBlock Classes="k" Text="访问令牌" /><TextBox Grid.Column="1" Classes="flat" PasswordChar="●" Text="{Binding ConnectDialog.Token}" /></Grid></Border>
        <Border Classes="dialog-line"><Grid Classes="dialog-row" Margin="0" ColumnDefinitions="70,*"><TextBlock Classes="k" Text="客户端名" /><TextBox Grid.Column="1" Classes="flat" Text="{Binding ConnectDialog.ClientName}" /></Grid></Border>
        <Border Classes="dialog-line"><Grid Classes="dialog-row" Margin="0" ColumnDefinitions="70,*"><TextBlock Classes="k" Text="令牌落盘" /><ToggleButton Grid.Column="1" Classes="flat channel-chip" HorizontalAlignment="Left" Content="记住令牌（默认只存地址）" IsChecked="{Binding ConnectDialog.RememberToken}" /></Grid></Border>
        <TextBlock Classes="dialog-status" Classes.error="{Binding ConnectDialog.HasError}" Text="{Binding ConnectDialog.Status}" />
        <StackPanel Classes="dialog-buttons">
          <Button Classes="flat edit-plan" Content="连接" Command="{Binding ConnectCommand}" IsEnabled="{Binding !ConnectDialog.Busy}" />
          <Button Classes="flat edit-plan" Content="取消" Command="{Binding CloseConnectDialogCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="backdrop" IsVisible="{Binding ControlDialog.IsOpen}" />
    <Border Classes="dialog" IsVisible="{Binding ControlDialog.IsOpen}">
      <StackPanel>
        <Border Classes="panel-heading">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Classes="breadcrumb"><c:IconView Geometry="{StaticResource IcoCheck}" Size="10" /><TextBlock Classes="strong" Text="申请远程控制" /><TextBlock Classes="muted" Text="租约 · 心跳 · 宽限" /></StackPanel>
            <StackPanel Grid.Column="1" Classes="heading-actions"><Button Classes="flat icon-button" Command="{Binding CloseControlDialogCommand}"><c:IconView Geometry="{StaticResource IcoClose}" Size="10" /></Button></StackPanel>
          </Grid>
        </Border>
        <Border Classes="dialog-line"><Grid Classes="dialog-row" Margin="0" ColumnDefinitions="70,*"><TextBlock Classes="k" Text="设备模式" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding ControlDialog.ModeText}" /></Grid></Border>
        <Border Classes="dialog-line"><Grid Classes="dialog-row" Margin="0" ColumnDefinitions="70,*"><TextBlock Classes="k" Text="持有者" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding ControlDialog.HolderText}" /></Grid></Border>
        <Border Classes="dialog-line"><Grid Classes="dialog-row" Margin="0" ColumnDefinitions="70,*"><TextBlock Classes="k" Text="本机租约" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding ControlDialog.LeaseText}" /></Grid></Border>
        <Border Classes="dialog-line"><Grid Classes="dialog-row" Margin="0" ColumnDefinitions="70,*"><TextBlock Classes="k" Text="客户端名" /><TextBlock Grid.Column="1" Classes="v" Text="{Binding Config.ClientName}" /></Grid></Border>
        <TextBlock Classes="dialog-status" Classes.ok="{Binding ControlDialog.Holding}" Text="{Binding ControlDialog.StatusLine}" />
        <StackPanel Classes="dialog-buttons">
          <Button Classes="flat edit-plan" Content="申请控制权" Command="{Binding RequestControlCommand}" IsEnabled="{Binding !ControlDialog.Holding}" />
          <Button Classes="flat edit-plan" Content="释放" Command="{Binding ReleaseControlCommand}" IsEnabled="{Binding ControlDialog.Holding}" />
          <Button Classes="flat edit-plan" Content="关闭" Command="{Binding CloseControlDialogCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="backdrop" IsVisible="{Binding EstopConfirmOpen}" />
    <Border Classes="dialog" IsVisible="{Binding EstopConfirmOpen}">
      <StackPanel>
        <Border Classes="panel-heading"><StackPanel Classes="breadcrumb"><c:IconView Geometry="{StaticResource IcoStop}" Size="10" Foreground="{DynamicResource Fail}" /><TextBlock Classes="strong" Text="急停" Foreground="{DynamicResource Fail}" /><TextBlock Classes="muted" Text="无需控制权 · 任何客户端可发" /></StackPanel></Border>
        <TextBlock Classes="dialog-status" Text="确认向设备发出急停？将切断全部加热、停止搅拌并关闭阀门；触屏需人工复位。" />
        <StackPanel Classes="dialog-buttons">
          <Button Classes="flat edit-plan danger" Content="确认急停" Command="{Binding ConfirmEstopCommand}" />
          <Button Classes="flat edit-plan" Content="取消" Command="{Binding CancelEstopCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Toast -->
    <Border Classes="toast" Classes.visible="{Binding ToastVisible}"><TextBlock Text="{Binding ToastText}" /></Border>
  </Panel>
</UserControl>
