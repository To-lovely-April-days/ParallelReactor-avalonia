<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ParallelReactor.Control.ViewModels"
        xmlns:v="using:ParallelReactor.Control.Views"
        x:Class="ParallelReactor.Control.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ParallelReactor 控制软件"
        Width="1440" Height="900" MinWidth="1080" MinHeight="600"
        Background="{DynamicResource AppBg}"
        FontFamily="{DynamicResource UiFont}" FontSize="9" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True">
  <v:MainView />
</Window>
