<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ParallelReactor.Control.ViewModels"
             xmlns:v="using:ParallelReactor.Control.Views"
             xmlns:c="using:ParallelReactor.Control.Controls"
             x:Class="ParallelReactor.Control.Views.PerfProgressView"
             x:DataType="vm:PerfViewModel">
  <!-- mock #progressPanel：标题「测试进度 · 状态」；#runView（进度条 / 总进度·已用时 / 步骤行 / 四张卡）与 #reportView（报告编号 · 表）切换 -->
  <Border Classes="panel">
    <Grid RowDefinitions="24,*">
      <Border Classes="panel-heading">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Classes="breadcrumb">
            <c:IconView Geometry="{StaticResource IcoMove}" Size="10" />
            <TextBlock Classes="strong" Text="{Binding ProgressTitle}" />
            <TextBlock Classes="muted" Text="{Binding StatusText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Classes="heading-actions">
            <Button Classes="flat icon-button" ToolTip.Tip="展开面板" Name="ExpandButton"><c:IconView Geometry="{StaticResource IcoExpand}" Size="10" /></Button>
            <Button Classes="flat icon-button" ToolTip.Tip="关闭面板" Name="CloseButton"><c:IconView Geometry="{StaticResource IcoClose}" Size="10" /></Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- #runView -->
      <ScrollViewer Grid.Row="1" Classes="progress-body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowRunView}">
        <StackPanel>
          <Border Classes="progress-bar"><c:FillBar Percent="{Binding OverallPercent}" /></Border>
          <Grid Classes="progress-meta" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{Binding OverallText}" />
            <TextBlock Grid.Column="1" Text="{Binding EtaText}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" />
          </Grid>

          <!-- .step-list -->
          <Border Classes="step-list">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PerfStepRowVm">
                  <Border Classes="step-row" Classes.done="{Binding IsDone}" Classes.current="{Binding IsCurrent}" Classes.waiting="{Binding IsWaiting}" Classes.sub="{Binding IsSub}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Ellipse Classes="step-dot" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" />
                      <TextBlock Grid.Column="2" Classes="right" Text="{Binding Right}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock Classes="event-line" Text="尚未开始：勾选测试项与通道后点击右侧「开始测试」（需持有控制权）" IsVisible="{Binding ShowStartHint}" Margin="4,4,0,0" />

          <!-- .manual-grid：当前步骤 / 人工录入 / 搅拌电机 / 反应器温度·压力 -->
          <UniformGrid Classes="manual-grid" Columns="2" Rows="2">
            <Border Classes="property-card green-edge">
              <Grid ColumnDefinitions="*,Auto">
                <Grid RowDefinitions="18,38">
                  <Grid Classes="property-path" ColumnDefinitions="Auto,*"><c:IconView Geometry="{StaticResource IcoTree}" Size="8" Foreground="#777777" Margin="0,0,3,0" /><TextBlock Grid.Column="1" Text="当前步骤" /></Grid>
                  <Grid Grid.Row="1" Classes="property-body" ColumnDefinitions="Auto,*,Auto">
                    <c:IconView Geometry="{StaticResource IcoClock}" Size="22" Stroke="1.7" Foreground="{DynamicResource Gauge}" Margin="5,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="property-primary" Text="{Binding CurName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="property-secondary" Text="{Binding CurHint}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="property-reading">
                      <TextBlock Classes="property-number" Text="{Binding Countdown}" />
                      <TextBlock Classes="property-unit" Text="{Binding CountdownLabel}" />
                    </StackPanel>
                  </Grid>
                </Grid>
                <Border Grid.Column="1" Classes="green-edge-bar" />
              </Grid>
            </Border>
            <Border Classes="property-card right" Classes.green-edge="{Binding EntryActive}">
              <Grid ColumnDefinitions="*,Auto">
                <Grid RowDefinitions="18,38">
                  <Grid Classes="property-path" ColumnDefinitions="Auto,*"><c:IconView Geometry="{StaticResource IcoTree}" Size="8" Foreground="#777777" Margin="0,0,3,0" /><TextBlock Grid.Column="1" Text="{Binding ManualPath}" /></Grid>
                  <Grid Grid.Row="1" Classes="property-body grow" ColumnDefinitions="Auto,*,Auto">
                    <c:IconView Geometry="{StaticResource IcoGauge}" Size="22" Stroke="1.7" Foreground="{DynamicResource Gauge}" Margin="5,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="property-primary" Text="{Binding ManualDev}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="property-secondary" Classes.fault="{Binding EntryError}" Text="{Binding ManualPrompt}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ManualPrompt}" />
                    </StackPanel>
                    <!-- 无录入：mock 的禁用「读数」框；有录入：每个读数一个 44px 框（多次 / 多通道换行） -->
                    <StackPanel Grid.Column="2" Classes="property-reading" IsVisible="{Binding !HasEntryBoxes}">
                      <TextBox Classes="flat reading" Watermark="读数" IsEnabled="False" Name="FirstEntryBox" />
                      <TextBlock Classes="property-unit" Text="{Binding ManualUnit}" />
                    </StackPanel>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding EntryFields}" IsVisible="{Binding HasEntryBoxes}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Classes="entry-wrap" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PerfEntryFieldVm">
                          <StackPanel IsVisible="{Binding !IsText}" ToolTip.Tip="{Binding Label}">
                            <TextBox Classes="flat reading" Classes.error="{Binding HasError}" Watermark="读数" Text="{Binding Text}" />
                            <TextBlock Classes="property-unit" Text="{Binding ShortLabel}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Grid>
                <Border Grid.Column="1" Classes="green-edge-bar" />
              </Grid>
            </Border>
            <Border Classes="property-card green-edge">
              <Grid ColumnDefinitions="*,Auto">
                <Grid RowDefinitions="18,38">
                  <Grid Classes="property-path" ColumnDefinitions="Auto,*"><c:IconView Geometry="{StaticResource IcoTree}" Size="8" Foreground="#777777" Margin="0,0,3,0" /><TextBlock Grid.Column="1" Text="/全局/搅拌电机" /></Grid>
                  <Grid Grid.Row="1" Classes="property-body" ColumnDefinitions="Auto,*,Auto">
                    <c:IconView Geometry="{StaticResource IcoGauge}" Size="22" Stroke="1.7" Foreground="{DynamicResource Gauge}" Margin="5,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="property-primary" Text="搅拌电机（全局）" />
                      <TextBlock Classes="property-secondary" Text="实际转速" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="property-reading">
                      <TextBlock Classes="property-number" Text="{Binding LiveRpm}" />
                      <TextBlock Classes="property-unit" Text="rpm" />
                    </StackPanel>
                  </Grid>
                </Grid>
                <Border Grid.Column="1" Classes="green-edge-bar" />
              </Grid>
            </Border>
            <Border Classes="property-card right">
              <Grid ColumnDefinitions="*,Auto">
                <Grid RowDefinitions="18,38">
                  <Grid Classes="property-path" ColumnDefinitions="Auto,*"><c:IconView Geometry="{StaticResource IcoTree}" Size="8" Foreground="#777777" Margin="0,0,3,0" /><TextBlock Grid.Column="1" Text="{Binding LivePath}" /></Grid>
                  <Grid Grid.Row="1" Classes="property-body" ColumnDefinitions="Auto,*,Auto">
                    <c:IconView Geometry="{StaticResource IcoGauge}" Size="22" Stroke="1.7" Foreground="{DynamicResource Gauge}" Margin="5,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="property-primary" Text="反应器温度 / 压力" />
                      <TextBlock Classes="property-secondary" Text="实时值" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="property-reading">
                      <TextBlock Classes="property-number" Text="{Binding LiveTp}" />
                      <TextBlock Classes="property-unit" Text="{Binding LiveRv}" />
                    </StackPanel>
                  </Grid>
                </Grid>
                <Border Grid.Column="1" Classes="green-edge-bar" />
              </Grid>
            </Border>
          </UniformGrid>

          <!-- 文字型录入（现象 / 状态） -->
          <Border Classes="prompt-card" IsVisible="{Binding HasExtraEntries}">
            <StackPanel>
              <TextBlock Classes="path" Text="{Binding ManualPath, StringFormat='{}{0} · 文字记录'}" />
              <ItemsControl ItemsSource="{Binding ExtraEntryFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:PerfEntryFieldVm">
                    <Grid Classes="entry-row" ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding Label}" Margin="0,0,6,0" />
                      <TextBox Grid.Column="1" Classes="flat" Classes.error="{Binding HasError}" Text="{Binding Text}" Watermark="现象 / 状态" Height="15" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 确认 / 检查表卡 -->
          <Border Classes="prompt-card" IsVisible="{Binding IsWaitingConfirm}">
            <StackPanel Spacing="3">
              <TextBlock Classes="path" Text="手动确认 · 完成现场操作后点击右侧「确认 / 继续」；「跳过」= 未确认" />
              <TextBlock Classes="title" Text="{Binding ConfirmTitle}" />
              <TextBlock Text="{Binding ConfirmText}" IsVisible="{Binding ConfirmText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ItemsControl ItemsSource="{Binding ChecklistItems}" IsVisible="{Binding HasChecklist}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:PerfCheckVm">
                    <CheckBox Classes="check-item" IsChecked="{Binding IsChecked}"><TextBlock Classes="check-text" Text="{Binding Text}" TextWrapping="NoWrap" /></CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="Auto,70,12,Auto,70" IsVisible="{Binding ConfirmTwoSigners}" Height="18">
                <TextBlock Text="签字 1" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBox Grid.Column="1" Classes="flat" Text="{Binding Signer1}" Height="15" />
                <TextBlock Grid.Column="3" Text="签字 2" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBox Grid.Column="4" Classes="flat" Text="{Binding Signer2}" Height="15" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" Height="18">
                <TextBlock Text="备注" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBox Grid.Column="1" Classes="flat" Text="{Binding OperatorNote}" Height="15" Watermark="可选" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 安全暂停卡 -->
          <Border Classes="prompt-card safety" IsVisible="{Binding IsWaitingSafety}">
            <StackPanel Spacing="3">
              <TextBlock Classes="path fail" Text="安全暂停 · 引擎已自动暂停，不会自动继续" />
              <TextBlock Classes="title fail" Text="{Binding SafetyText}" />
              <TextBlock Text="{Binding SafetyRecommendation}" />
              <TextBlock Classes="path" Text="右侧「确认 / 继续」= 继续本次运行；「中止」= 停止本项加热 / 搅拌并生成报告。急停按钮在菜单栏，随时可按。" />
            </StackPanel>
          </Border>

          <!-- 事件行 -->
          <Border Classes="step-list" Margin="0,6,0,0" IsVisible="{Binding IsRunning}">
            <ItemsControl ItemsSource="{Binding EventLines}" Margin="4,3,0,0" MaxHeight="66">
              <ItemsControl.ItemTemplate><DataTemplate DataType="x:String"><TextBlock Classes="event-line" Text="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- #reportView -->
      <ScrollViewer Grid.Row="1" Classes="progress-body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowReport}">
        <StackPanel>
          <TextBlock Classes="simulated-banner" Text="模拟运行（PR_SIM）：数据无效，仅验证流程" IsVisible="{Binding Simulated}" />
          <Grid Classes="progress-meta" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Text="{Binding ReportMeta}" />
            <TextBlock Grid.Column="1" Text="{Binding ReportTime}" />
          </Grid>
          <Border Classes="report-head">
            <Grid ColumnDefinitions="2.2*,0.9*,1.4*,1.1*,0.9*,0.9*">
              <TextBlock Text="测试项" /><TextBlock Grid.Column="1" Text="通道" /><TextBlock Grid.Column="2" Text="设定 / 标准" /><TextBlock Grid.Column="3" Text="实测" /><TextBlock Grid.Column="4" Text="误差" /><TextBlock Grid.Column="5" Text="判定" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding ReportRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:PerfReportRowVm">
                <Border Classes="report-row">
                  <Grid ColumnDefinitions="2.2*,0.9*,1.4*,1.1*,0.9*,0.9*">
                    <TextBlock Text="{Binding Item}" Classes.item="{Binding IsItem}" />
                    <TextBlock Grid.Column="1" Text="{Binding Channel}" /><TextBlock Grid.Column="2" Text="{Binding Setting}" /><TextBlock Grid.Column="3" Text="{Binding Measured}" /><TextBlock Grid.Column="4" Text="{Binding Error}" />
                    <TextBlock Grid.Column="5" Classes.pass="{Binding IsPass}" Classes.fail="{Binding IsFail}" Text="{Binding VerdictText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Classes="progress-meta" ColumnDefinitions="*" Margin="0,6,0,0">
            <TextBlock Text="{Binding ReportPath, StringFormat='报告文件 {0}'}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReportPath}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="6">
            <Button Classes="flat edit-plan" Margin="0" Width="80" Content="打开报告" Command="{Binding OpenReportCommand}" />
            <Button Classes="flat edit-plan" Margin="0" Width="80" Content="打开文件夹" Command="{Binding OpenFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
