<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:ParallelReactor.Control.Controls"
                    xmlns:g="using:ParallelReactor.Control.Views.Pages.Gallery">
  <!-- 陈列页自己的外观（MOCK css/placeholder.css 的 gallery-*）。只用色板令牌。 -->

  <!-- 行高：样稿 body line-height 1.45（Avalonia 的 LineHeight 与 CSS 一样把多出的行距上下平分，见 font-probe）；
       参照图是 WebKit 拍的，它把行高截成整数 px（14 × 1.45 = 20.3 → 20，16 × 1.45 = 23.2 → 23），这里取同样的整数，分区高度才对得上 -->
  <x:Double x:Key="GalleryLh14">20</x:Double>
  <x:Double x:Key="GalleryLh16">23</x:Double>

  <!-- 说明文字（.gallery-cap / ui.field 的标签与提示）：14 px t-3（标签 500），行高 1.45 -->
  <ControlTheme x:Key="GalleryCap" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Fs2}" />
    <Setter Property="Foreground" Value="{StaticResource T3Brush}" />
    <Setter Property="LineHeight" Value="{StaticResource GalleryLh14}" />
  </ControlTheme>
  <ControlTheme x:Key="GalleryFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource GalleryCap}">
    <Setter Property="FontWeight" Value="Medium" />
  </ControlTheme>

  <!-- 色板色块的内描边：t-1 的 14 % 透明度变体（样稿 inset 0 0 0 1px rgba(47,47,53,.14)） -->
  <SolidColorBrush x:Key="SwatchEdgeBrush" Color="{StaticResource T1Color}" Opacity="0.14" />

  <!-- 分区：白卡 1 px line-2、圆角 6、卡片阴影；标题栏 bg-head + 下边 line-faint、内边距 12 16；内容内边距 16 -->
  <ControlTheme x:Key="{x:Type g:GallerySection}" TargetType="g:GallerySection">
    <!-- 不裁剪：焦点环 / 阴影画在控件外面（Avalonia 11.1 的模板控件默认 ClipToBounds=true） -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{StaticResource ShadowCard}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource BgHeadBrush}" BorderBrush="{StaticResource LineFaintBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="5,5,0,0" Padding="16,12">
              <c:BaselineStack Spacing="12">
                <TextBlock Text="{TemplateBinding Title}" FontSize="{StaticResource FsTitle}" FontWeight="SemiBold"
                           LineHeight="{StaticResource GalleryLh16}" Foreground="{StaticResource T1Brush}" />
                <TextBlock Text="{TemplateBinding Sub}" FontSize="{StaticResource Fs2}" LineHeight="{StaticResource GalleryLh14}"
                           Foreground="{StaticResource T3Brush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{TemplateBinding Sub}" />
              </c:BaselineStack>
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
