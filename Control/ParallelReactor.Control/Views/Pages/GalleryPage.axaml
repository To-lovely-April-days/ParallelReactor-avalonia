<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:ParallelReactor.Control.Views.Pages.Gallery"
             xmlns:pr="using:ParallelReactor.Control.Controls.Pr"
             x:Class="ParallelReactor.Control.Views.Pages.GalleryPage"
             Background="{StaticResource BgAppBrush}">
  <!-- 组件陈列页（MOCK #/gallery，设计 / 自检用，不在菜单里）：分区与样稿相同，每个分区是 Gallery/ 下一个独立的 UserControl。
       M1：色板、字号、按钮、输入、徽标与状态、进度、面板 · 属性卡片、提示 · 表格 · 键值 · 倒计时 · 空状态；M4：釜体（ReactorVessel / VesselGlyph）；
       M5：曲线（TimeSeriesChart，三张）、步骤卡片（StepFlowPanel + 与反应釜页共用的步骤卡片，Gallery/StepsSection）。M2 起是新外壳里的路由页（PageHost 放进纵向滚动区），
       截图时窗口带 frozen 类（Theme/Frozen.cs）。悬停提示是全局默认的 PrTip。 -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ParallelReactor.Control/Views/Pages/Gallery/GalleryTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- .gallery-in：上 20 左右 24 下 40，分区间距 16 -->
  <StackPanel Name="Sections" Margin="24,20,24,40" Spacing="16">
    <g:GallerySection Title="色板" Sub="RESTYLE-BRIEF §2 · 封闭集合 · Tokens.axaml / Palette.cs">
      <g:PaletteSection />
    </g:GallerySection>
    <g:GallerySection Title="字号" Sub="正文 15 px · 任何文字 ≥ 13 px · 中文 ≥ 14 px">
      <g:TypeScaleSection />
    </g:GallerySection>
    <g:GallerySection Title="按钮" Sub="次要（默认）· 主要（每区一个）· 停止类（灰方块）· 单台急停（描边）· 全局急停（唯一红色实心）">
      <g:ButtonsSection />
    </g:GallerySection>
    <g:GallerySection Title="输入" Sub="控件 36 px（紧凑 34）">
      <g:InputsSection />
    </g:GallerySection>
    <g:GallerySection Title="徽标与状态" Sub="中性；报警 = 红点；提醒 = 描边 ⚠；运行 = 浅绿点">
      <g:BadgesSection />
    </g:GallerySection>
    <g:GallerySection Title="进度" Sub="白底细边框 + 浅绿渐变；运行中缓慢呼吸（freeze=1 关闭）">
      <g:ProgressSection />
    </g:GallerySection>
    <g:GallerySection Title="面板 · 属性卡片" Sub="路径行 · 线描图标 · 名称 / 粗体说明 · 右对齐读数 28 px · 实时值 4 px 绿边">
      <g:PanelSection />
    </g:GallerySection>
    <g:GallerySection Title="步骤卡片" Sub="白卡细边框 · 当前步浅绿渐变 · 已完成灰色 ✓ · 条件框浅灰">
      <g:StepsSection />
    </g:GallerySection>
    <g:GallerySection Title="釜体" Sub="线描去色：液体按状态 · 加热 = 实线夹套 + 单色火焰 + HT · 报警红圈">
      <g:VesselSection />
    </g:GallerySection>
    <g:GallerySection Title="曲线" Sub="温度灰 · 压力灰绿 · 设定值虚线 · 标记紫色虚线 · 上限只在接近 / 超过时出现">
      <g:ChartsSection />
    </g:GallerySection>
    <g:GallerySection Title="提示 · 表格 · 键值 · 倒计时 · 空状态">
      <g:MiscSection />
    </g:GallerySection>
  </StackPanel>
</UserControl>
