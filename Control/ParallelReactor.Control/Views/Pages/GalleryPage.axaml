<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:ParallelReactor.Control.Views.Pages.Gallery"
             xmlns:pr="using:ParallelReactor.Control.Controls.Pr"
             x:Class="ParallelReactor.Control.Views.Pages.GalleryPage"
             Background="{StaticResource BgAppBrush}">
  <!-- 组件陈列页（设计 / 自检用，不在菜单里）：每个分区是 Gallery/ 下一个独立的 UserControl。融合版 F1：控件换成 main-fusion.html 的样子，
       新加「外框零件」（深蓝条、菜单栏、运行胶囊、工具条、停靠面板、状态栏）与「运行表」两个分区。以下是 pc-v3 时的说明：分区与样稿 #/gallery 相同。
       M1：色板、字号、按钮、输入、徽标与状态、进度、面板 · 属性卡片、提示 · 表格 · 键值 · 倒计时 · 空状态；M4：釜体（ReactorVessel / VesselGlyph）；
       M5：曲线（TimeSeriesChart，三张）、步骤卡片（StepFlowPanel + 与反应釜页共用的步骤卡片，Gallery/StepsSection）。M2 起是新外壳里的路由页（PageHost 放进纵向滚动区），
       截图时窗口带 frozen 类（Theme/Frozen.cs）。悬停提示是全局默认的 PrTip。 -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ParallelReactor.Control/Views/Pages/Gallery/GalleryTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- .gallery-in：上 20 左右 24 下 40，分区间距 16 -->
  <StackPanel Name="Sections" Margin="24,20,24,40" Spacing="16">
    <g:GallerySection Title="色板" Sub="融合版 · 封闭集合 · tools/fusion-tokens.json → Tokens.axaml / Palette.cs · ALZK 品牌蓝 + 灰白，没有紫色">
      <g:PaletteSection />
    </g:GallerySection>
    <g:GallerySection Title="字号" Sub="正文 13 px · 单元格 14 · 读数 15/600 · 任何文字 ≥ 13 px（中文同）">
      <g:TypeScaleSection />
    </g:GallerySection>
    <g:GallerySection Title="按钮" Sub="次要（默认，细边 28）· 主要（品牌蓝，每区一个）· 停止类（灰方块）· 单台急停（描边）· 红色实心只给急停">
      <g:ButtonsSection />
    </g:GallerySection>
    <g:GallerySection Title="输入" Sub="输入框 30 px · 圆角 3 · 聚焦品牌蓝边 + 光晕 · 开关 38 × 22 · 分段直角细边">
      <g:InputsSection />
    </g:GallerySection>
    <g:GallerySection Title="外框零件" Sub="窗口内深蓝条 30 · 菜单栏 54（24 px 细体）· 运行胶囊 · 工具条 46 · 停靠面板（竖条 28 + 灰带 42）· 状态栏 26">
      <g:FrameSection />
    </g:GallerySection>
    <g:GallerySection Title="运行表" Sub="表头 40（13/500 t-3）· 行 44 · 读数 15/600 · 选中 = 左侧 3 px 品牌蓝 + 浅蓝底 · 报警行 = 左侧 3 px 红 + 浅红底">
      <g:RunTableSection />
    </g:GallerySection>
    <g:GallerySection Title="徽标与状态" Sub="标签 22 · 运行 = 绿 · 提醒 = 琥珀 · 报警 = 红 · 状态写成字">
      <g:BadgesSection />
    </g:GallerySection>
    <g:GallerySection Title="进度" Sub="已完成 a-done · 运行中品牌蓝；运行中缓慢呼吸（freeze=1 关闭）">
      <g:ProgressSection />
    </g:GallerySection>
    <g:GallerySection Title="面板 · 属性卡片" Sub="路径行 · 线描图标 · 名称 / 粗体说明 · 右对齐读数 28 px · 实时值 4 px 绿边">
      <g:PanelSection />
    </g:GallerySection>
    <g:GallerySection Title="步骤卡片" Sub="白卡细边框 · 当前步浅蓝底 · 已完成灰色 ✓ · 条件框浅灰（F6 按融合版的程序页重做）">
      <g:StepsSection />
    </g:GallerySection>
    <g:GallerySection Title="釜体" Sub="线描去色：液体按状态 · 加热 = 实线夹套 + 单色火焰 + HT · 报警红圈">
      <g:VesselSection />
    </g:GallerySection>
    <g:GallerySection Title="曲线" Sub="温度橙 · 压力品牌蓝 · 设定值灰虚线 · 标记深灰虚线 · 上限红虚线只在接近 / 超过时出现">
      <g:ChartsSection />
    </g:GallerySection>
    <g:GallerySection Title="提示 · 表格 · 键值 · 倒计时 · 空状态">
      <g:MiscSection />
    </g:GallerySection>
  </StackPanel>
</UserControl>
