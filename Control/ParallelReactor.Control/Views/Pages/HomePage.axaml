<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ParallelReactor.Control.Controls"
             xmlns:pr="using:ParallelReactor.Control.Controls.Pr"
             xmlns:cs="using:ParallelReactor.Control.Controls.Shell"
             xmlns:pg="using:ParallelReactor.Control.Pages"
             xmlns:b="using:ParallelReactor.Control.Behaviors"
             xmlns:vp="using:ParallelReactor.Control.Views.Pages.Home"
             x:Class="ParallelReactor.Control.Views.Pages.HomePage"
             x:DataType="pg:HomePageVm">
  <!-- 主页：
       选了设备：看板（上一行「通道」气路图；下一行「曲线」1.9 : 「共用资源」1，行高约 1.7 : 1，间距 8），三块均可折叠成竖条；
       总览：每台设备一张卡片。 -->
  <UserControl.Styles>
    <Style Selector="Border.phead">
      <Setter Property="Height" Value="{StaticResource PaneHeadH}" />
      <Setter Property="Background" Value="{StaticResource PaneHeadBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PaneHeadLineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Border.axtag">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource AmbLineBrush}" />
      <Setter Property="Background" Value="{StaticResource AmbBgBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.axtag.err">
      <Setter Property="BorderBrush" Value="{StaticResource RLineBrush}" />
      <Setter Property="Background" Value="{StaticResource RBgBrush}" />
    </Style>
    <!-- 窄屏：曲线说明不写、断线横条折两行 -->
    <Style Selector="Grid#Board.narrow vp|OverlayPaneView StackPanel#Opt">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Board.narrow vp|NetBannerView TextBlock#Txt">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Board.narrow vp|NetBannerView StackPanel#Txt2">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- 灰带里的竖线（1 × 18 line） -->
    <Style Selector="Border.vsep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="{StaticResource LineBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <!-- 看板：上一行「通道」（气路图）；下一行「曲线」1.9 : 「共用资源」1；三块都能折叠成竖条。 -->
    <Grid Name="Board" RowDefinitions="1.7*,8,*" IsVisible="{Binding !IsOverview}" Classes.narrow="{Binding IsNarrow}" Classes.short="{Binding IsShort}">
      <cs:DockPane Name="PMon" Grid.Row="0" Title="通道" Mode="{Binding MonMode}" ToggleCommand="{Binding ToggleMonCommand}" HorizontalAlignment="Stretch">
        <DockPanel>
          <!-- 灰带：「运行 6/8 ｜ 共用搅拌 ｜ 状态标签」…「停止1号机」；面板窄于 800 时不写运行数和电流 -->
          <Border Classes="phead" DockPanel.Dock="Top" Padding="14,0,8,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Theme="{StaticResource PrStop}" b:Pr.Icon="stop" Content="{Binding StopDevLabel}" Command="{Binding StopDeviceCommand}"
                        ToolTip.Tip="停止这台设备上的全部通道（打开「全部停止」，已预选这台）· 不需要控制权" />
              </StackPanel>
              <StackPanel Name="MvTool" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" ClipToBounds="True">
                <TextBlock Name="MvRun" VerticalAlignment="Center" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T2Brush}">
                  <Run Text="运行 " /><Run Text="{Binding RunCount}" FontWeight="SemiBold" Foreground="{StaticResource T1Brush}" /><Run Text="{Binding RunOf}" />
                </TextBlock>
                <Border Name="MvSep1" Classes="vsep" />
                <vp:StirCtlView Name="MvStir" DataContext="{Binding Res}" IsVisible="{Binding HasStir}" VerticalAlignment="Center" />
                <Border Name="MvManual" Classes="axtag" IsVisible="{Binding Res.ManualValve}" ToolTip.Tip="有人在设备触屏上手动开关阀门；PC 上的阀门状态跟着触屏变">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <c:IconView Icon="wrench" Size="14" Foreground="{StaticResource AmbInkBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="触屏手动阀控中" FontSize="{StaticResource FsBase}" FontWeight="SemiBold" Foreground="{StaticResource AmbInkBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Name="MvFault" Classes="axtag err" IsVisible="{Binding Res.StirFault}" ToolTip.Tip="搅拌电机故障 · 只能在设备触屏上清除 · 全部釜已停止搅拌">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <c:IconView Icon="err-f" Size="14" Foreground="{StaticResource RInkBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Res.StirFaultTitle}" FontSize="{StaticResource FsBase}" FontWeight="SemiBold" Foreground="{StaticResource RInkBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>
          </Border>
          <vp:NetBannerView DockPanel.Dock="Top" DataContext="{Binding Net}" IsVisible="{Binding IsVisible}" />
          <vp:GasView Name="GasV" />
        </DockPanel>
      </cs:DockPane>
      <Grid Name="Row2" Grid.Row="2" ColumnDefinitions="1.9*,8,*">
        <cs:DockPane Name="PCurve" Grid.Column="0" Title="曲线" Mode="{Binding CurveMode}" ToggleCommand="{Binding ToggleCurveCommand}">
          <vp:OverlayPaneView DataContext="{Binding Curve}" />
        </cs:DockPane>
        <cs:DockPane Name="PRes" Grid.Column="2" Title="共用资源" Mode="{Binding ResMode}" ToggleCommand="{Binding ToggleResCommand}">
          <vp:ResPaneView DataContext="{Binding Res}" />
        </cs:DockPane>
      </Grid>
    </Grid>
    <!-- 总览：每台设备一张卡片 -->
    <Border Name="Overview" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource LineSepBrush}" BorderThickness="1"
            IsVisible="{Binding IsOverview}">
      <Border.Styles>
        <Style Selector="Button.ovdev">
          <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="2" />
          <Setter Property="Margin" Value="5" />
          <Setter Property="Height" Value="NaN" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Stretch" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Template">
            <ControlTemplate>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Button.ovdev:pointerover">
          <Setter Property="BorderBrush" Value="{StaticResource ABrush}" />
        </Style>
        <Style Selector="Button.ovdev:focus-visible">
          <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
        </Style>
        <Style Selector="Border.mat">
          <Setter Property="Height" Value="30" />
          <Setter Property="Margin" Value="2" />
          <Setter Property="CornerRadius" Value="2" />
          <Setter Property="Background" Value="{StaticResource BgPressBrush}" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.mat.run">
          <Setter Property="BorderBrush" Value="{StaticResource GDotBrush}" />
          <Setter Property="BorderThickness" Value="0,0,0,3" />
        </Style>
        <Style Selector="Border.mat.err">
          <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource RBrush}" />
          <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.mat TextBlock">
          <Setter Property="FontSize" Value="{StaticResource FsBase}" />
          <Setter Property="Foreground" Value="{StaticResource T2Brush}" />
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.mat.err TextBlock">
          <Setter Property="Foreground" Value="{StaticResource RBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="StackPanel.kpi TextBlock">
          <Setter Property="FontSize" Value="{StaticResource FsBase}" />
          <Setter Property="Foreground" Value="{StaticResource T3Brush}" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.kpi Run.b">
          <Setter Property="FontSize" Value="18" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Foreground" Value="{StaticResource T1Brush}" />
        </Style>
      </Border.Styles>
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource LineMenuBrush}" BorderThickness="0,0,0,1"
                Padding="14,0,6,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <pr:PrText Text="总览" FontSize="{StaticResource FsDevAll}" FontWeight="Light" Foreground="{StaticResource GbgTitleBrush}" VerticalAlignment="Center" />
            <Border BorderBrush="{StaticResource LineSepBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0" VerticalAlignment="Center">
              <pr:PrText Text="{Binding OverviewSub}" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T3Brush}" />
            </Border>
          </StackPanel>
        </Border>
        <ScrollViewer Theme="{StaticResource PrScrollViewer}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Cards}" Margin="7" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pg:HomeCardVm">
                  <Button Classes="ovdev" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Alias}">
                    <DockPanel>
                      <Border DockPanel.Dock="Top" Height="3" Background="{Binding State, Converter={x:Static pg:HomeConverters.OvBar}}" />
                      <Border DockPanel.Dock="Top" Height="42" Padding="12,0" BorderBrush="{StaticResource LineFaintBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                          <Border DockPanel.Dock="Right" Height="24" Padding="10,0" CornerRadius="2" BorderThickness="1"
                                  Background="{StaticResource ASoftBrush}" BorderBrush="{StaticResource ATabBrush}" IsVisible="{Binding Remote}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                              <c:IconView Icon="plug" Size="14" Foreground="{StaticResource ABrush}" VerticalAlignment="Center" />
                              <pr:PrText Text="远程控制" FontSize="{StaticResource FsBase}" FontWeight="SemiBold" Foreground="{StaticResource ABrush}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                          <Border DockPanel.Dock="Right" Height="24" Padding="10,0" CornerRadius="2" BorderThickness="1"
                                  Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource LineSepBrush}" IsVisible="{Binding !Remote}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                              <c:IconView Icon="lock" Size="14" Foreground="{StaticResource T2Brush}" VerticalAlignment="Center" />
                              <pr:PrText Text="{Binding LeaseShort}" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T2Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding State, Converter={x:Static pg:HomeConverters.OvDot}}" VerticalAlignment="Center" />
                            <pr:PrText Text="{Binding Alias}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource T1Brush}" VerticalAlignment="Center" />
                            <pr:PrText Text="{Binding Model}" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T3Brush}" VerticalAlignment="Center" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                      <StackPanel DockPanel.Dock="Top" Classes="kpi" Orientation="Horizontal" Spacing="16" Margin="12,10">
                        <TextBlock><Run Text="运行 " /><Run Classes="b num" Text="{Binding RunText}" /></TextBlock>
                        <TextBlock><Run Text="报警 " /><Run Classes="b num" Text="{Binding ErrText}" Foreground="{Binding HasErr, Converter={x:Static pg:HomeConverters.OvErrInk}}" /></TextBlock>
                        <TextBlock ToolTip.Tip="设备按压降计算的吸气量（各路合计）"><Run Text="气体消耗 " /><Run Classes="b num" Text="{Binding GasText}" /><Run Text=" mmol" /></TextBlock>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Mats}" Margin="10,-2,10,10" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="pg:OvMatVm">
                            <Border Classes="mat" Classes.run="{Binding IsRun}" Classes.err="{Binding IsErr}" ToolTip.Tip="{Binding Tip}">
                              <TextBlock Classes="num" Text="{Binding Num}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <pr:PrText Text="点设备卡片进入这台设备的看板（通道 · 曲线 · 共用资源）" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T3Brush}" Margin="14,0,14,14" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
