<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:th="using:ParallelReactor.Control.Theme"
             xmlns:pg="using:ParallelReactor.Control.Pages"
             xmlns:h="using:ParallelReactor.Control.Pages.Home"
             xmlns:hc="using:ParallelReactor.Control.Controls.Home"
             x:Class="ParallelReactor.Control.Views.Pages.Home.VesselView"
             x:DataType="pg:HomePageVm">
  <!-- 通道面板 · 反应釜卡片（融合版 F4，样稿 vesselView / vesselCard + .vgrid / .vcard 一族）。
       网格：8 路、16 路 8 列，4 路 4 列；内边距 8 12 10，间距 8（16 路 6）。卡片：白底、line 边、圆角 8；选中品牌蓝边 + 外圈。
       卡头「RV1」14/600 + 状态点 / 报警标记，下一行状态字 13 t-3；釜图 96（卡宽 ≥ 190：图在左 116、读数在右、温度 28）；
       温度 22/600 +「°C」· 目标 13 t-3 · 细线 · 压力 14/600 t-2（报警红底白字）· 转速 · 步骤小条（每步一段）·「3/4 · 剩 27 min」13 t-3。
       紧凑（16 路一律；面板高 ≤ 300 时全部）：只留 编号 / 状态 / 釜图 / 温度 / 压力，居中。类由代码按尺寸设（代替样稿的容器查询）。 -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ParallelReactor.Control/Views/Pages/Home/MonTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.vc">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="4,0,4,8" />
    </Style>
    <Style Selector="Panel#Root.n16 Button.vc">
      <Setter Property="Margin" Value="3,0,3,6" />
    </Style>
    <!-- 卡头 -->
    <Style Selector="Grid.vh">
      <Setter Property="Margin" Value="8,7,8,0" />
    </Style>
    <Style Selector="Grid.vh TextBlock.rvn">
      <Setter Property="FontSize" Value="{StaticResource FsCell}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource T1Brush}" />
    </Style>
    <Style Selector="Grid.vh TextBlock.vst">
      <Setter Property="FontSize" Value="{StaticResource FsBase}" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource T3Brush}" />
    </Style>
    <Style Selector="Grid.vh TextBlock.vst.err">
      <Setter Property="Foreground" Value="{StaticResource RInkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid.vh hc|TileMarkView">
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 釜图 + 读数 -->
    <Style Selector="DockPanel.vb Border.vill">
      <Setter Property="Padding" Value="0,2,0,0" />
      <Setter Property="DockPanel.Dock" Value="Top" />
    </Style>
    <Style Selector="DockPanel.vb hc|VesselArt">
      <Setter Property="Width" Value="96" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.vrd">
      <Setter Property="Margin" Value="8,2,8,8" />
    </Style>
    <Style Selector="StackPanel.vrd TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="StackPanel.vrd TextBlock.vtp">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="LineHeight" Value="29" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource T1Brush}" />
    </Style>
    <Style Selector="StackPanel.vrd Run.u">
      <Setter Property="FontSize" Value="{StaticResource FsBase}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{StaticResource T3Brush}" />
    </Style>
    <Style Selector="StackPanel.vrd TextBlock.vsv, StackPanel.vrd TextBlock.vpt">
      <Setter Property="FontSize" Value="{StaticResource FsBase}" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource T3Brush}" />
    </Style>
    <Style Selector="StackPanel.vrd TextBlock.vpt">
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="StackPanel.vrd Border.vdv">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="Background" Value="{StaticResource LineFaintBrush}" />
    </Style>
    <Style Selector="StackPanel.vrd StackPanel.vm">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="StackPanel.vm TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.vm TextBlock.b">
      <Setter Property="FontSize" Value="{StaticResource FsCell}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource T2Brush}" />
    </Style>
    <Style Selector="StackPanel.vm TextBlock.u">
      <Setter Property="FontSize" Value="{StaticResource FsBase}" />
      <Setter Property="Foreground" Value="{StaticResource T3Brush}" />
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
    <Style Selector="StackPanel.vm Border.hot">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.vm Border.hot.on">
      <Setter Property="Background" Value="{StaticResource RBrush}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="-4,0,0,0" />
    </Style>
    <Style Selector="StackPanel.vm Border.hot.on TextBlock.b">
      <Setter Property="Foreground" Value="{StaticResource TInvBrush}" />
    </Style>
    <Style Selector="StackPanel.vrd hc|StepStrip">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="Height" Value="4" />
    </Style>
    <Style Selector="Button.vc.off StackPanel.vrd TextBlock.vtp, Button.vc.off StackPanel.vm TextBlock.b">
      <Setter Property="Foreground" Value="{StaticResource TDisBrush}" />
    </Style>

    <!-- 宽卡（卡宽 ≥ 190：4 路 1920）：图在左 116、读数在右、温度 28 / 32 -->
    <Style Selector="Panel#Root.wide DockPanel.vb">
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
    <Style Selector="Panel#Root.wide DockPanel.vb Border.vill">
      <Setter Property="DockPanel.Dock" Value="Left" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel#Root.wide DockPanel.vb hc|VesselArt">
      <Setter Property="Width" Value="116" />
    </Style>
    <Style Selector="Panel#Root.wide StackPanel.vrd">
      <Setter Property="Margin" Value="0,6,10,8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel#Root.wide StackPanel.vrd TextBlock.vtp">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="LineHeight" Value="35" />
    </Style>

    <!-- 紧凑（16 路；面板高 ≤ 300 时全部）：居中，只留 编号 / 状态 / 釜图 / 温度 / 压力 -->
    <Style Selector="Panel#Root.cmp Grid.vh">
      <Setter Property="Margin" Value="4,5,4,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel#Root.cmp Grid.vh TextBlock.vst">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel#Root.n16 Grid.vh TextBlock.vst">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel#Root.cmp DockPanel.vb hc|VesselArt">
      <Setter Property="Width" Value="64" />
    </Style>
    <Style Selector="Panel#Root.cmp.n4 DockPanel.vb hc|VesselArt">
      <Setter Property="Width" Value="76" />
    </Style>
    <Style Selector="Panel#Root.n16 DockPanel.vb hc|VesselArt">
      <Setter Property="Width" Value="66" />
    </Style>
    <Style Selector="Panel#Root.cmp StackPanel.vrd">
      <Setter Property="Margin" Value="4,0,4,6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel#Root.cmp StackPanel.vrd TextBlock.vtp">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel#Root.cmp StackPanel.vrd StackPanel.vm">
      <Setter Property="Height" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel#Root.cmp StackPanel.vm TextBlock.b">
      <Setter Property="FontSize" Value="{StaticResource FsBase}" />
    </Style>
    <Style Selector="Panel#Root.cmp StackPanel.vm Border.hot.on">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Panel#Root.cmp TextBlock.vsv, Panel#Root.cmp Border.vdv, Panel#Root.cmp StackPanel.vm.r, Panel#Root.cmp hc|StepStrip, Panel#Root.cmp TextBlock.vpt">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- 窄卡（≤ 112）：不写剩余时间；≤ 84：温度 16 -->
    <Style Selector="Panel#Root.c112 TextBlock.vpt">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel#Root.c84 StackPanel.vrd TextBlock.vtp">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
  </UserControl.Styles>

  <Panel Name="Root" Background="{StaticResource BgCardBrush}">
    <ScrollViewer Theme="{StaticResource PrScrollViewerWide}" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl Name="Cards" ItemsSource="{Binding Tiles}" Margin="8,8,8,2" VerticalAlignment="Top">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="{Binding MonCols}" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="h:MonTileVm">
            <Button Classes="vc" Theme="{StaticResource PrMonCard}" Classes.on="{Binding IsSelected}" Classes.off="{Binding IsOff}" Click="OnTile"
                    ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Rv}">
              <StackPanel>
                <Grid Classes="vh" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Classes="rvn" Text="{Binding Rv}" />
                  <hc:TileMarkView Grid.Column="1" Dot="{Binding Dot}" Mark="{Binding Mark}" ToolTip.Tip="{Binding MarkTip}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="vst" Classes.err="{Binding IsErr}" Text="{Binding Word}" />
                </Grid>
                <DockPanel Classes="vb">
                  <Border Classes="vill">
                    <hc:VesselArt Heat="{Binding Heat}" Cooling="{Binding Cooling}" Off="{Binding IsOff}" Err="{Binding IsErr}" Bubbles="{Binding Bubbles}"
                                  TFrac="{Binding TFrac}" SpFrac="{Binding SpFrac}" PFrac="{Binding PFrac}" LimFrac="{Binding LimFrac}" />
                  </Border>
                  <StackPanel Classes="vrd">
                    <TextBlock Classes="vtp num"><Run Text="{Binding TempText}" /><Run Classes="u" Text=" °C" /></TextBlock>
                    <TextBlock Classes="vsv" Text="{Binding SpLine}" />
                    <Border Classes="vdv" />
                    <StackPanel Classes="vm">
                      <Border Classes="hot" Classes.on="{Binding PressHot}"><TextBlock Classes="b num" Text="{Binding PressText}" /></Border>
                      <TextBlock Classes="u" Text="{Binding Unit, Source={x:Static th:PressureText.Instance}}" />
                    </StackPanel>
                    <StackPanel Classes="vm r">
                      <TextBlock Classes="b num" Text="{Binding RpmText}" />
                      <TextBlock Classes="u" Text="rpm" />
                    </StackPanel>
                    <hc:StepStrip Segs="{Binding Segs}" />
                    <TextBlock Classes="vpt" Text="{Binding StepLine}" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Panel>
</UserControl>
