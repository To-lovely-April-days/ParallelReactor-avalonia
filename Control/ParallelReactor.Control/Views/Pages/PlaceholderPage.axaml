<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ParallelReactor.Control.Controls"
             xmlns:pr="using:ParallelReactor.Control.Controls.Pr"
             xmlns:pg="using:ParallelReactor.Control.Pages"
             x:Class="ParallelReactor.Control.Views.Pages.PlaceholderPage"
             x:DataType="pg:PlaceholderPageVm">
  <!-- 还没做的页面（融合版 F2 占位）：一块白色面板（同样稿其它页面的 .board.pg .panel：1 px pane-line、圆角 4、ShadowCard）——
       灰带（42 高、pane-head、下边 pane-head-line）：标题 15/600 + 英文名 13 px t-3 字距 .08em；正文：这一页会有什么 + 由哪个阶段做。 -->
  <Border Background="{StaticResource PaneBgBrush}" BorderBrush="{StaticResource PaneLineBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius}"
          BoxShadow="{StaticResource ShadowCard}" ClipToBounds="True">
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="{StaticResource PaneHeadH}" Background="{StaticResource PaneHeadBrush}" BorderBrush="{StaticResource PaneHeadLineBrush}"
              BorderThickness="0,0,0,1" Padding="14,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <pr:PrText Text="{Binding Title}" FontSize="{StaticResource FsPaneTitle}" FontWeight="SemiBold" Foreground="{StaticResource PaneTitleBrush}" VerticalAlignment="Center" />
          <pr:PrText Text="{Binding English}" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T3Brush}" LetterSpacing="1" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <StackPanel Margin="40" Spacing="14" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AWashBrush}" BorderBrush="{StaticResource ALineBrush}" BorderThickness="1"
                HorizontalAlignment="Center">
          <c:IconView Icon="f-task" Size="26" Foreground="{StaticResource ABrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsKpi}" FontWeight="Light" Foreground="{StaticResource T1Brush}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Text}" FontSize="{StaticResource FsCell}" LineHeight="22" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{StaticResource T2Brush}" HorizontalAlignment="Stretch" />
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <c:IconView Icon="f-info" Size="14" Foreground="{StaticResource T3Brush}" VerticalAlignment="Center" />
          <pr:PrText Text="{Binding Stage, StringFormat='这一页在 {0}做'}" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T3Brush}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
