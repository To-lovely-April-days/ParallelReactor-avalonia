<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ParallelReactor.Control.Controls"
             xmlns:pr="using:ParallelReactor.Control.Controls.Pr"
             xmlns:pg="using:ParallelReactor.Control.Pages"
             x:Class="ParallelReactor.Control.Views.Pages.PlaceholderPage"
             x:DataType="pg:PlaceholderPageVm">
  <!-- 第二阶段视图的占位（样稿 pages/placeholder.js、css/placeholder.css）：一个面板（标题 + 图标 + 「第二阶段」，不能关闭），
       内容居中：72 px 图标块（圆角 12、白底、line-2 边、a-d 图标 32、卡片阴影）· 标题 22/600 · 说明 15 px（行高 1.75，最宽 640）· 提示 14 px t-3。
       底色：bg-side 上一层白色 45 % → 0（左 22 %）的横向渐变。不做半成品。 -->
  <UserControl.Resources>
    <LinearGradientBrush x:Key="PlaceholderSheenBrush" StartPoint="0%,0%" EndPoint="22%,0%">
      <GradientStop Offset="0" Color="{StaticResource BgCardColor}" />
      <GradientStop Offset="1" Color="Transparent" />
    </LinearGradientBrush>
  </UserControl.Resources>
  <pr:PrPanel Title="{Binding Title}" Icon="{Binding Icon}" Sub="第二阶段" CanClose="False">
    <Panel Background="{StaticResource BgSideBrush}">
      <Border Background="{StaticResource PlaceholderSheenBrush}" Opacity="0.45" />
      <!-- 整列铺满（居中靠各自的对齐）：说明是居中对齐的多行文字，铺满时测量宽度 = 排版宽度（最宽 640，更宽的工作区里居中放），
           窗口变宽之后不会按旧宽度居中、偏出框（见 Styles/Theme/Components.axaml 的空状态） -->
      <StackPanel Spacing="16" Margin="40" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Border Width="72" Height="72" CornerRadius="12" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource Line2Brush}"
                BorderThickness="1" BoxShadow="{StaticResource ShadowCard}" HorizontalAlignment="Center">
          <c:IconView Icon="{Binding Icon}" Size="32" Foreground="{StaticResource ADBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <!-- 行高照 WebKit 取整（样稿 body 行高 1.45：22 px → 31.9 → 31，14 px → 20.3 → 20）：整块高 231 与样稿相同，居中后位置一致 -->
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource T1Brush}" HorizontalAlignment="Center"
                   LineHeight="31" Margin="0,4,0,0" />
        <!-- 说明照抄样稿（esc(p.text)，不用 PR.keep / keep-all）：中文可以在任意两个字之间断行，断在哪里与样稿一致 -->
        <TextBlock Name="Body" Text="{Binding Text}" MaxWidth="640" FontSize="{StaticResource FsBody}" LineHeight="26" TextWrapping="Wrap"
                   TextAlignment="Center" Foreground="{StaticResource T2Brush}" HorizontalAlignment="Stretch" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
          <c:IconView Icon="info" Size="16" Foreground="{StaticResource T3Brush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Hint}" FontSize="{StaticResource Fs2}" Foreground="{StaticResource T3Brush}" LineHeight="{StaticResource Lh2}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Panel>
  </pr:PrPanel>
</UserControl>
