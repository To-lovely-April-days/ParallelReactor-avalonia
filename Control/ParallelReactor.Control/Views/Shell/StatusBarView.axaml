<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ParallelReactor.Control.Controls"
             xmlns:pr="using:ParallelReactor.Control.Controls.Pr"
             xmlns:sh="using:ParallelReactor.Control.Shell"
             x:Class="ParallelReactor.Control.Views.Shell.StatusBarView"
             x:DataType="sh:ShellVm">
  <!-- 状态栏（融合版 F2；样稿 renderStatus / .status）：高 26、bg-bar、上边 line-grey、左右 12、间距 10、13 px t-2、不换行。
       项 = 13 px 图标 + 文字（间距 5）；项之间 1 × 14 line-sep 竖线。红色只给事实：「未确认 n」r 700、断线时连接项整项红色。
       左：已连接 · [F3 的项：已阻止睡眠 / 重连中] · 远程控制 · 记录 · 报警 · 选中的通道；右：示例型号 · 参数为假设 · 采样 1 s · 日期时间。 -->
  <UserControl.Styles>
    <Style Selector="StackPanel.it">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.it > c|IconView">
      <Setter Property="Size" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.it.alert">
      <Setter Property="TextElement.Foreground" Value="{StaticResource RBrush}" />
    </Style>
    <Style Selector="Border.sep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Background" Value="{StaticResource LineSepBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.axst">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Height="22" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="{StaticResource AxBrandLBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ABrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.axst.amb">
      <Setter Property="Background" Value="{StaticResource AmbBgBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AxAmbTextBrush}" />
    </Style>
    <Style Selector=":is(Control).narrow Button.axst">
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector=":is(Control).narrow Button.axst c|IconView.axi">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <Border Background="{StaticResource BgBarBrush}" BorderBrush="{StaticResource LineGreyBrush}" BorderThickness="0,1,0,0" Padding="12,0"
          TextElement.FontSize="{StaticResource FsBase}" TextElement.Foreground="{StaticResource T2Brush}">
    <DockPanel ClipToBounds="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" VerticalAlignment="Center">
        <StackPanel Classes="it" IsVisible="{Binding Status.NoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <pr:PrText Text="{Binding Status.NoteText}" VerticalAlignment="Center" />
        </StackPanel>
        <Border Classes="sep" IsVisible="{Binding Status.NoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <pr:PrText Text="{Binding Status.SampleText}" VerticalAlignment="Center" />
        <Border Classes="sep" />
        <pr:PrText Classes="num" Text="{Binding Status.ClockText}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <StackPanel Classes="it" Classes.alert="{Binding Status.Conn.Alert}" ToolTip.Tip="{Binding Status.Conn.Text}">
          <c:IconView Icon="{Binding Status.Conn.Icon}" />
          <pr:PrText Text="{Binding Status.Conn.Text}" VerticalAlignment="Center" />
        </StackPanel>
        <!-- F3 的状态项（运行中 · 已阻止睡眠、重连中 …）：每项前面一条竖线 -->
        <ItemsControl ItemsSource="{Binding Status.Extra}" VerticalAlignment="Center" IsVisible="{Binding Status.HasExtra}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sh:StatusItem">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="sep" />
                <StackPanel Classes="it" Classes.alert="{Binding Alert}" ToolTip.Tip="{Binding Tip}">
                  <c:IconView Icon="{Binding Icon}" />
                  <pr:PrText Text="{Binding Text}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="sep" />
        <StackPanel Classes="it">
          <c:IconView Icon="plug" />
          <pr:PrText Text="{Binding Status.RemoteText}" VerticalAlignment="Center" />
        </StackPanel>
        <Border Classes="sep" />
        <StackPanel Classes="it">
          <c:IconView Icon="rec" />
          <pr:PrText Text="{Binding Status.RecordText}" VerticalAlignment="Center" />
        </StackPanel>
        <Border Classes="sep" />
        <StackPanel Classes="it">
          <c:IconView Icon="bell" />
          <TextBlock VerticalAlignment="Center">
            <Run Text="{Binding Status.AlarmText}" /><Run Text="{Binding Status.AlarmRed}" FontWeight="Bold" Foreground="{StaticResource RBrush}" /><Run Text="{Binding Status.AlarmTail}" />
          </TextBlock>
        </StackPanel>
        <Border Classes="sep" IsVisible="{Binding Status.SelText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <pr:PrText Text="{Binding Status.SelText}" VerticalAlignment="Center"
                   IsVisible="{Binding Status.SelText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- v0.8.1 收起了的设备活动（样稿 .status .axst，v2 去掉框线）：22 高、圆角 4、左右 8（窄屏 6、不画图标）、a 浅底品牌蓝字；等人操作琥珀 -->
        <ItemsControl ItemsSource="{Binding Status.Acts}" VerticalAlignment="Center" IsVisible="{Binding Status.HasActs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sh:ActStatusVm">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="sep" />
                <Button Classes="axst" Classes.amb="{Binding Amb}" Command="{Binding Command}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Text}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <c:IconView Classes="axi" Icon="{Binding Icon}" Size="14" VerticalAlignment="Center" />
                    <TextBlock Classes="num" Text="{Binding Text}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
