<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:pr="using:ParallelReactor.Control.Controls.Pr"
             xmlns:cs="using:ParallelReactor.Control.Controls.Shell"
             xmlns:sh="using:ParallelReactor.Control.Shell"
             xmlns:vs="using:ParallelReactor.Control.Views.Shell"
             xmlns:hc="using:ParallelReactor.Control.Controls.Home"
             x:Class="ParallelReactor.Control.Views.Shell.ShellView"
             x:DataType="sh:ShellVm">
  <!-- 外框里显示字符串内容的地方（按钮、菜单、状态栏…）都用 PrText（按 WebKit 的方式量宽，并排的中文标签不会每个多 2 px）。
       旧样式的页面（Views/Legacy/LegacyHost）在宿主里换回普通 TextBlock。 -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="sys:String" x:DataType="sys:String">
      <pr:PrText Text="{Binding}" />
    </DataTemplate>
  </UserControl.DataTemplates>
  <!-- 选择器都带上外框视图的类型（vs|MenuBarView …）：名字只在各自的视图里唯一，别的视图（步骤条件框的 Border#Box…）不能被误中。
       宽窄屏（样稿 @media max-width: 1599px）：菜单栏 22 px、左右 9；深蓝条不写产品名；报警摘要只剩一行；本机只剩图标；设备下拉最小宽 150、不写量程；
       工具条按钮左右 9，「文件 / 导出 / 报告 / 配置 / 视图」组只剩 30 × 30 的图标。报警列表 440 宽。 -->
  <UserControl.Styles>
    <Style Selector="vs|MenuBarView TextBlock#AckLine">
      <Setter Property="Foreground" Value="{StaticResource T3Brush}" />
    </Style>
    <Style Selector="vs|MenuBarView TextBlock#AckLine.ua">
      <Setter Property="Foreground" Value="{StaticResource RInkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|StripView TextBlock#StripTitle">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|MenuBarView Button.mi">
      <Setter Property="FontSize" Value="{StaticResource FsMenuNarrow}" />
      <Setter Property="Padding" Value="9,0" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|MenuBarView Button.mi.badge">
      <Setter Property="Padding" Value="9,0,26,0" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|MenuBarView TextBlock#AckLine">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|MenuBarView StackPanel#UserText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|RibbonView ComboBox#DevSel">
      <Setter Property="MinWidth" Value="150" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|RibbonView Button.rb">
      <Setter Property="Padding" Value="9,0" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|RibbonView ItemsControl.compact Button.rb">
      <Setter Property="Width" Value="30" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|RibbonView ItemsControl.compact Button.rb /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- 报警弹窗的小趋势：矮屏 72 高（样稿 @media max-height 820 .apop .ach svg） -->
    <Style Selector="Grid#Root.short vs|AlarmPopView hc|MiniTrend">
      <Setter Property="Height" Value="72" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|ActivityPanelView#ActPanel">
      <Setter Property="Margin" Value="0,0,40,12" />
    </Style>
    <Style Selector="Grid#Root.narrow vs|AlarmPopover Border#AlarmBox">
      <Setter Property="Width" Value="440" />
    </Style>
  </UserControl.Styles>
  <!-- 融合版外框（F2；样稿 main-fusion.html .app）：系统标题栏之下，自上而下
         30 深蓝条（StripView）/ 54 菜单栏（MenuBarView：页面 · 运行胶囊 · 报警摘要 · 本机）/ 46 工具条（RibbonView）/
         停靠区（bg-app、内边距 8、间距 8：设备面板 296 | 看板（PageHost）| 检查器 30 收起 / 340）/ 26 状态栏。
       窄屏（&lt; 1600）：设备面板与检查器默认收起成 30 的竖条，展开时浮出（跨列摆、固定宽 330 / 400、浮出阴影，ShellView.axaml.cs 按 DockLayout 摆）。
       浮层：报警列表（菜单栏下 4 px、右 8、停靠区底边上 8，ZIndex 100）、对话框宿主（200）、toast（400）。
       根元素的类 narrow / short 给宽窄、矮屏的样式用（菜单栏字号、工具条只剩图标、深蓝条不写产品名…）。 -->
  <Grid Name="Root" Background="{StaticResource DockBgBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="54" />
      <RowDefinition Height="46" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <vs:StripView Grid.Row="0" />
    <vs:MenuBarView Grid.Row="1" />
    <vs:RibbonView Grid.Row="2" />

    <Border Grid.Row="3" Background="{StaticResource DockBgBrush}" Padding="{StaticResource DockPadding}">
      <Grid Name="Dock">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="296" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <!-- 行高 / 列宽同令牌 StripH 30、MenubarH 54、RibbonH 46、StatusBarH 26、DockGap 8（GridLength 不能直接引用 x:Double 资源）。
             子元素的先后 = Tab 的先后：设备面板 → 看板 → 检查器；画在谁上面只看 ZIndex（浮出 60） -->
        <cs:DockPane Name="DevPane" Grid.Column="0" Title="设备" ZIndex="2"
                     Mode="{Binding Layout.DevicesMode}" ToggleCommand="{Binding Devices.ToggleCommand}">
          <cs:DockPane.RailExtra>
            <vs:RailDevices />
          </cs:DockPane.RailExtra>
          <vs:DevicePaneView />
        </cs:DockPane>
        <vs:PageHost Name="Pages" Grid.Column="2" />
        <cs:DockPane Name="InspPane" Grid.Column="4" Title="检查器" IsRight="True" ZIndex="2"
                     Mode="{Binding Layout.InspectorMode}">
          <!-- 融合版 F3：检查器只在「主页 + 选了设备」时有，显示选中的一路（样稿 ctlHTML） -->
          <vs:ChannelCtlView DataContext="{Binding Ctl}" />
        </cs:DockPane>
      </Grid>
    </Border>

    <vs:StatusBarView Grid.Row="4" />

    <!-- v0.8.1 浮动活动面板（样稿 .axdock：右 44、状态栏上 16；窄屏右 40、上 12）：不是模态，只占自己的矩形；报警列表 / 报警弹窗 / 对话框盖在它上面 -->
    <vs:ActivityPanelView Name="ActPanel" Grid.Row="3" ZIndex="90" DataContext="{Binding Activity}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,44,16" />

    <vs:AlarmPopover Name="AlarmPop" Classes="audit-layer" Grid.Row="2" Grid.RowSpan="2" ZIndex="100" Margin="0,4,8,8" HorizontalAlignment="Right"
                     IsVisible="{Binding Alarms.IsOpen}" />

    <vs:AlarmPopView Grid.RowSpan="5" ZIndex="150" DataContext="{Binding AlarmPop}" IsVisible="{Binding IsOpen}" />
    <vs:DialogHost Grid.RowSpan="5" ZIndex="200" />
    <vs:ToastHost Grid.RowSpan="5" ZIndex="400" />
  </Grid>
</UserControl>
