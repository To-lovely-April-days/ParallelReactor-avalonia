<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ParallelReactor.Control.Controls"
             xmlns:pr="using:ParallelReactor.Control.Controls.Pr"
             xmlns:b="using:ParallelReactor.Control.Behaviors"
             xmlns:dlg="using:ParallelReactor.Control.Shell.Dialogs"
             xmlns:vd="using:ParallelReactor.Control.Views.Shell.Dialogs"
             x:Class="ParallelReactor.Control.Views.Shell.Dialogs.PickDialogView"
             x:DataType="dlg:PickDialogVm">
  <!-- 急停 / 全部停止（融合版 F3，样稿 pick + stopTbl + STOP_NOTE）：开头一句 · 「对气路做什么」表 · 琥珀说明 · 设备勾选（上 10，行间 8：
       1 px line 边、圆角 3、左右 10、高 40：复选框 16 + 别名 14 t-1 + 型号 13 t-3 + 右侧「运行 6/8」13 t-3）· 预选说明（13 t-3）。 -->
  <UserControl.Styles>
    <Style Selector="Border.pbox">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
      <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.on Border.pbox">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.dis Border.pbox">
      <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
      <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
    </Style>
    <Style Selector="Button.prow">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <StackPanel>
    <vd:StopInfoView />
    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="dlg:PickRowVm">
          <Button Theme="{StaticResource PrPickRow}" Classes="prow" Classes.on="{Binding IsOn}" Classes.dis="{Binding Reason, Converter={x:Static ObjectConverters.IsNotNull}}"
                  b:Pr.Reason="{Binding Reason}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Alias}" ToolTip.Tip="{Binding Sub}">
            <DockPanel>
              <Panel DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                <Border Classes="pbox" />
                <c:IconView Icon="f-check" Size="16" Foreground="{StaticResource T1Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsOn}" />
              </Panel>
              <pr:PrText DockPanel.Dock="Right" Text="{Binding RunText}" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T3Brush}" VerticalAlignment="Center" Margin="12,0,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <pr:PrText Text="{Binding Alias}" FontSize="{StaticResource FsCell}" Foreground="{StaticResource T1Brush}" TextTrimming="CharacterEllipsis" />
                <pr:PrText Text="{Binding Model}" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T3Brush}" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <pr:PrText Text="{Binding PreText}" FontSize="{StaticResource FsBase}" Foreground="{StaticResource T3Brush}" Margin="0,8,0,0"
               IsVisible="{Binding PreText, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </StackPanel>
</UserControl>
