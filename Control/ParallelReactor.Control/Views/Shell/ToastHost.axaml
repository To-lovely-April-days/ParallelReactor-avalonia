<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ParallelReactor.Control.Controls"
             xmlns:sv="using:ParallelReactor.Control.Services"
             xmlns:sh="using:ParallelReactor.Control.Shell"
             x:Class="ParallelReactor.Control.Views.Shell.ToastHost"
             x:DataType="sh:ShellVm"
             Classes="audit-layer"
             IsHitTestVisible="False">
  <!-- Toast（样稿 .pr-toasts / .pr-toast）：距外框底 48、水平居中、上下堆叠间距 8，不接收指针；
       每条：toast 深色底、圆角 6、内边距 11 20 11 16、15 px 白字（行高 21）、ShadowPop、最宽 820、不换行；
       语气：ok = 白色 ✓（16，描边 2.2；成功不用绿色）· info = a-line 点 · warn = n-dot 点 · err = r 点 + 2 px 白环（8 px 点）。
       类 audit-layer：提示浮在外框上面（同样稿 position: fixed 的 .pr-toasts），盖住下面的时间轴 / 页面是设计如此 —— 截图审计的重叠只在这一层里比
       （M5 的 rv-progx 截的就是关掉「程序」之后的提示，1600 / 1366 时盖在时间轴的步骤条上）。 -->
  <UserControl.Styles>
    <!-- 阴影（ShadowPop：0 8 28）画在框外：ItemsControl、模板里的 ItemsPresenter、每条的 ContentPresenter 都不裁剪
         （Avalonia 11.1 的模板控件默认 ClipToBounds=true，它们正好是提示那么大 —— 阴影整个被裁掉；同 DialogHost） -->
    <Style Selector="ItemsControl#ToastList, ItemsControl#ToastList /template/ ItemsPresenter, ItemsControl#ToastList ContentPresenter">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
  </UserControl.Styles>
  <ItemsControl Name="ToastList" ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Spacing="8" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="sv:ToastItem">
        <Border HorizontalAlignment="Center" MaxWidth="820" Padding="16,11,20,11" CornerRadius="{StaticResource Radius}"
                Background="{StaticResource ToastBrush}" BoxShadow="{StaticResource ShadowPop}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <c:IconView Icon="check" Size="16" StrokeWidth="2.2" Foreground="{StaticResource TInvBrush}" VerticalAlignment="Center"
                        IsVisible="{Binding IsOk}" />
            <Panel Width="8" Height="8" VerticalAlignment="Center" ClipToBounds="False" IsVisible="{Binding IsErr}">
              <Ellipse Width="12" Height="12" Margin="-2" Fill="{StaticResource TInvBrush}" Opacity="0.85" />
              <Ellipse Width="8" Height="8" Fill="{StaticResource RBrush}" />
            </Panel>
            <Ellipse Width="8" Height="8" Fill="{StaticResource ALineBrush}" VerticalAlignment="Center" IsVisible="{Binding IsInfo}" />
            <Ellipse Width="8" Height="8" Fill="{StaticResource NDotBrush}" VerticalAlignment="Center" IsVisible="{Binding IsWarn}" />
            <TextBlock Text="{Binding Text}" FontSize="{StaticResource FsBody}" LineHeight="{StaticResource LhBody}" Foreground="{StaticResource TInvBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
